# Build-time settings for the static site. On GitHub: Settings → Secrets and variables → Actions → *Variables*.
# Everything here is PUBLIC once built — never put secrets in these.

# public = indexable by search engines. Anything else = noindex (default until launch).
SITE_VISIBILITY=noindex

# External RSVP service endpoint (e.g. Formspree: https://formspree.io/f/xxxxxxxx). Blank = RSVP form shows "not open yet".
PUBLIC_RSVP_ENDPOINT=

# Approved group-chat invite link (WhatsApp, etc.). Blank = the "Connect with other guests" link stays hidden.
PUBLIC_GUEST_GROUP_URL=
# rsvp = link shown only after confirming attendance (default) | public = shown on the Travel page
PUBLIC_GUEST_GROUP_GATE=rsvp

# Optional privacy-friendly analytics (Plausible). Blank = no analytics script.
PUBLIC_PLAUSIBLE_DOMAIN=

# Only for a custom domain: SITE_URL=https://example.com  BASE_PATH=

---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Schedule from '../components/Schedule.astro';
import AddToCalendar from '../components/AddToCalendar.astro';
import VenueMap from '../components/VenueMap.astro';
import NavigateButtons from '../components/NavigateButtons.astro';
import ComingSoon from '../components/ComingSoon.astro';
import { wedding, venue, addressLines, couple } from '../content/site';
---
<Base title="Details" description={`${couple.display} · ${wedding.dateLong} at ${venue.name}, ${wedding.cityLine}.`}>
  <section class="section pb-12">
    <div class="wrap">
      <SectionHead as="h1" eyebrow="The Details" title="Saturday, August&nbsp;28, 2027" />
      <div class="mt-14 grid gap-12 md:grid-cols-2 lg:grid-cols-3">
        <div class="reveal border-t border-charcoal/20 pt-6"><p class="eyebrow">Venue</p><p class="display mt-3 text-3xl">{venue.name}</p><p class="mt-3 text-taupe">{addressLines.map((l) => <span class="block">{l}</span>)}</p></div>
        <div class="reveal border-t border-charcoal/20 pt-6"><p class="eyebrow">About the venue</p><p class="mt-3">{venue.blurb}</p><p class="mt-3"><a class="link" href={venue.website} target="_blank" rel="noopener noreferrer">Venue website ↗</a></p></div>
        <div class="reveal border-t border-charcoal/20 pt-6"><p class="eyebrow">Save the date</p><div class="mt-4"><AddToCalendar /></div></div>
      </div>
    </div>
  </section>

  <section class="section pt-8" id="schedule">
    <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.6fr]">
      <SectionHead eyebrow="The day" title="Schedule" />
      <div class="reveal"><Schedule /></div>
    </div>
  </section>

  <section class="section border-t border-charcoal/12 bg-paper" id="directions">
    <div class="wrap">
      <SectionHead eyebrow="Getting there" title="Directions &amp; parking" />
      <div class="reveal mt-12"><VenueMap /></div>
      <div class="reveal mt-8"><NavigateButtons /></div>
      <div class="mt-14 grid gap-10 md:grid-cols-3">
        <div class="reveal"><p class="eyebrow">Arrival</p><div class="mt-3">{venue.arrivalNotes ? <p>{venue.arrivalNotes}</p> : <ComingSoon>Arrival instructions coming soon</ComingSoon>}</div></div>
        <div class="reveal"><p class="eyebrow">Parking</p><div class="mt-3">{venue.parkingNotes ? <p>{venue.parkingNotes}</p> : <ComingSoon>Parking details coming soon</ComingSoon>}</div></div>
        <div class="reveal"><p class="eyebrow">Coming from your hotel?</p><p class="mt-3 text-taupe">Pick your hotel on the <a class="link" href={u("/travel")}>travel page</a> to see the route and drive time to {venue.name}.</p></div>
      </div>
    </div>
  </section>
</Base>

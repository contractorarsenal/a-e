---
import Base from '../layouts/Base.astro';
import Schedule from '../components/Schedule.astro';
import AddToCalendar from '../components/AddToCalendar.astro';
import VenueMap from '../components/VenueMap.astro';
import NavigateButtons from '../components/NavigateButtons.astro';
import ComingSoon from '../components/ComingSoon.astro';
import { wedding, venue, addressLines, couple } from '../content/site';
import { u } from '../lib/url';
---
<Base title="The Wedding" description={`${couple.display} · ${wedding.dateLong} at ${venue.name}, ${wedding.cityLine}.`}>
  <div class="wrap pb-6 pt-10 md:pt-16">
    <h1 class="display text-[clamp(2.6rem,8vw,5rem)]">The Wedding</h1>

    <dl class="mt-10 border-t border-charcoal/20 md:mt-14">
      <!-- WHEN -->
      <div class="grid gap-3 border-b border-charcoal/20 py-8 md:grid-cols-[11rem_1fr] md:gap-10 md:py-10">
        <dt class="label pt-1.5">When</dt>
        <dd>
          <p class="display text-[clamp(1.7rem,4vw,2.4rem)]">{wedding.dateLong}</p>
          <div class="mt-6"><Schedule /></div>
          <div class="mt-7"><AddToCalendar /></div>
        </dd>
      </div>

      <!-- WHERE -->
      <div class="grid gap-3 border-b border-charcoal/20 py-8 md:grid-cols-[11rem_1fr] md:gap-10 md:py-10" id="directions">
        <dt class="label pt-1.5">Where</dt>
        <dd>
          <p class="display text-[clamp(1.7rem,4vw,2.4rem)]">{venue.name}</p>
          <address class="mt-2 text-lg not-italic text-taupe">{addressLines.slice(0, 2).map((l) => <span class="block">{l}</span>)}</address>
          <p class="mt-5 max-w-lg">{venue.blurb}</p>
          <div class="mt-7"><NavigateButtons /></div>
          <div class="mt-8"><VenueMap /></div>
          <div class="mt-8 grid gap-6 md:grid-cols-2">
            <div><p class="label">Arrival</p><div class="mt-2">{venue.arrivalNotes ? <p>{venue.arrivalNotes}</p> : <ComingSoon>Arrival details to be confirmed</ComingSoon>}</div></div>
            <div><p class="label">Parking</p><div class="mt-2">{venue.parkingNotes ? <p>{venue.parkingNotes}</p> : <ComingSoon>Parking details to be confirmed</ComingSoon>}</div></div>
          </div>
        </dd>
      </div>

      <!-- GETTING HERE -->
      <div class="grid gap-3 border-b border-charcoal/20 py-8 md:grid-cols-[11rem_1fr] md:gap-10 md:py-10">
        <dt class="label pt-1.5">Getting here</dt>
        <dd class="max-w-lg">
          <p>Hotels with their approximate drive time to {venue.name}, airports and rides are on <a class="link" href={u('/travel')}>Travel &amp; Stay</a>.</p>
        </dd>
      </div>
    </dl>

    <p class="mt-10 flex flex-wrap gap-x-8 text-sm"><a class="link tap" href={u('/story')}>Our story</a><a class="link tap" href={u('/faq')}>Questions</a><a class="link tap" href={u('/rsvp')}>RSVP</a></p>
  </div>
</Base>

---
import Base from '../layouts/Base.astro';
import Schedule from '../components/Schedule.astro';
import AddToCalendar from '../components/AddToCalendar.astro';
import VenueMap from '../components/VenueMap.astro';
import NavigateButtons from '../components/NavigateButtons.astro';
import ComingSoon from '../components/ComingSoon.astro';
import { wedding, venue, addressLines, couple } from '../content/site';
import { u } from '../lib/url';
---
<Base title="Details" description={`${couple.display} · ${wedding.dateLong} at ${venue.name}, ${wedding.cityLine}.`}>
  <header class="section pb-6 text-center md:pb-10">
    <div class="wrap">
      <p class="eyebrow hero-in" style="--i:0">The details</p>
      <h1 class="display hero-in mt-5 text-[clamp(3rem,11vw,8rem)] leading-[.92]" style="--i:1">Saturday, <span class="italic-display">August&nbsp;28</span></h1>
      <p class="hero-in mt-6 text-taupe" style="--i:2">Two thousand twenty-seven · {wedding.cityLine}</p>
    </div>
  </header>

  <!-- venue: set in ink like the back of an invitation -->
  <section class="on-ink mt-12 py-20 md:mt-20 md:py-32">
    <div class="wrap grid gap-12 md:grid-cols-12 md:gap-8">
      <div class="reveal md:col-span-7">
        <p class="eyebrow">Where</p>
        <h2 class="italic-display mt-5 text-[clamp(3rem,9vw,7rem)] leading-[.95]">{venue.name}</h2>
        <address class="mt-8 text-lg not-italic text-ivory/85">{addressLines.map((l) => <span class="block">{l}</span>)}</address>
      </div>
      <div class="reveal md:col-span-4 md:col-start-9 md:self-end">
        <p class="text-ivory/80">{venue.blurb}</p>
        <p class="mt-5"><a class="link tap" href={venue.website} target="_blank" rel="noopener noreferrer">Venue website ↗</a></p>
      </div>
    </div>
  </section>

  <section class="section" id="schedule">
    <div class="wrap grid gap-10 lg:grid-cols-12">
      <div class="reveal lg:col-span-4"><p class="eyebrow">The day</p><h2 class="display mt-4 text-[clamp(2.4rem,5vw,4rem)]">Schedule</h2></div>
      <div class="reveal lg:col-span-7 lg:col-start-6"><Schedule /></div>
    </div>
  </section>

  <section class="bg-paper py-20 md:py-28" id="directions">
    <div class="wrap">
      <div class="reveal flex flex-wrap items-end justify-between gap-6">
        <div><p class="eyebrow">Getting there</p><h2 class="display mt-4 text-[clamp(2.4rem,5vw,4rem)]">Directions</h2></div>
        <NavigateButtons />
      </div>
      <div class="reveal mt-10"><VenueMap /></div>
      <div class="mt-14 grid gap-10 md:grid-cols-3 md:gap-12">
        <div class="reveal border-t border-charcoal/20 pt-5"><p class="eyebrow">Arrival</p><div class="mt-3">{venue.arrivalNotes ? <p>{venue.arrivalNotes}</p> : <ComingSoon>Arrival instructions coming soon</ComingSoon>}</div></div>
        <div class="reveal border-t border-charcoal/20 pt-5"><p class="eyebrow">Parking</p><div class="mt-3">{venue.parkingNotes ? <p>{venue.parkingNotes}</p> : <ComingSoon>Parking details coming soon</ComingSoon>}</div></div>
        <div class="reveal border-t border-charcoal/20 pt-5"><p class="eyebrow">From your hotel</p><p class="mt-3 text-taupe">Pick your hotel on the <a class="link" href={u('/travel#concierge')}>travel page</a> to see the route and approximate drive time to {venue.name}.</p></div>
      </div>
    </div>
  </section>

  <section class="section text-center">
    <div class="wrap reveal">
      <p class="eyebrow">Save the date</p>
      <div class="mx-auto mt-6 flex justify-center"><AddToCalendar /></div>
    </div>
  </section>
</Base>

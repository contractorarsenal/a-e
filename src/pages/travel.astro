---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
import TripConcierge from '../components/trip/TripConcierge';
import GuestConnect from '../components/GuestConnect.astro';
import ComingSoon from '../components/ComingSoon.astro';
import { couple, venue, wedding, mapLinks, schedule, shuttle } from '../content/site';
import { hotels, rentals, stayDates, airports, rentalCompanies, sanRentalFacts, transit, guidance, travelIntro } from '../content/travel';
import geo from '../generated/geo.json';
import { groupUrl, groupGate } from '../lib/env';
import type { ConciergeData } from '../components/trip/types';

const hotelData = hotels.map((h) => ({
  ...h,
  lat: (geo.hotels as any)[h.id].lat, lon: (geo.hotels as any)[h.id].lon,
  toVenue: (geo.hotelToVenue as any)[h.id],
  fromAirport: Object.fromEntries(Object.keys(geo.airports).map((c) => [c, (geo.airportToHotel as any)[c][h.id]])),
}));
const notes: Record<string, string> = {
  SAN: 'Largest choice of flights, with a rental car center served by a free shuttle.',
  CRQ: 'Smaller and closer. Check airlines for current commercial service.',
  ONT: 'Alternative with a much longer drive.',
  SNA: 'Alternative with a much longer drive.',
  LAX: 'Most flights, and the longest drive.',
};
const airportData = Object.entries(geo.airports).map(([code, a]: [string, any]) => ({
  code, name: a.name, note: notes[code] ?? '', lat: a.lat, lon: a.lon,
  toVenue: (geo.airportToVenue as any)[code],
  toHotel: Object.fromEntries(hotels.map((h) => [h.id, (geo.airportToHotel as any)[code][h.id]])),
}));
const gUrl = groupUrl();
const groupPublic = groupGate() === 'public';
const data: ConciergeData = {
  hotels: hotelData as any,
  airports: airportData as any,
  venue: { name: venue.name, address: `${venue.street}, ${venue.city}, ${venue.region} ${venue.postal}`, lat: geo.venue.lat, lon: geo.venue.lon, googleDirections: mapLinks.googleDirections, appleDirections: mapLinks.appleDirections },
  couple: couple.display, dateISO: wedding.dateISO, dateLong: wedding.dateLong,
  schedule, stay: stayDates, rentals, rentalCompanies,
  routeMeta: { provider: geo.provider, date: geo.generatedAt, note: geo.note },
  group: { state: gUrl ? (groupPublic ? 'public' : 'gated') : 'none', url: gUrl && groupPublic ? gUrl : null },
  base: import.meta.env.BASE_URL.replace(/\/$/, ''),
};
---
<Base dark title="Plan Your Trip" description={`Hotels, airports, rental cars and directions for ${couple.display}'s wedding at ${venue.name} in ${wedding.cityLine}.`}>
  <!-- header -->
  <header class="on-ink relative isolate overflow-hidden pb-16 pt-36 md:pb-24 md:pt-48">
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-sea/70 to-ink" aria-hidden="true"></div>
    <div class="wrap grid items-end gap-12 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <p class="eyebrow hero-in" style="--i:0">Travel</p>
        <h1 class="display hero-in mt-5 text-[clamp(3.4rem,12vw,9rem)] leading-[.9]" style="--i:1">Plan your <span class="italic-display text-sand">trip</span></h1>
        <p class="hero-in mt-8 max-w-xl text-lg text-ivory/80" style="--i:2">{travelIntro}</p>
      </div>
      <nav aria-label="On this page" class="hero-in lg:col-span-3 lg:col-start-10" style="--i:3">
        <ul class="divide-y divide-ivory/15 border-y border-ivory/15 text-[.72rem] uppercase tracking-[.24em]">
          <li><a class="flex min-h-12 items-center justify-between text-ivory/85 hover:text-ivory" href="#concierge">Hotels &amp; planner <span aria-hidden="true">↓</span></a></li>
          <li><a class="flex min-h-12 items-center justify-between text-ivory/85 hover:text-ivory" href="#airports">Airports <span aria-hidden="true">↓</span></a></li>
          <li><a class="flex min-h-12 items-center justify-between text-ivory/85 hover:text-ivory" href="#cars">Cars &amp; rides <span aria-hidden="true">↓</span></a></li>
          <li><a class="flex min-h-12 items-center justify-between text-ivory/85 hover:text-ivory" href={u('/details#directions')}>Venue directions <span aria-hidden="true">→</span></a></li>
        </ul>
      </nav>
    </div>
  </header>

  <section id="concierge" class="bg-paper py-16 md:py-28">
    <div class="wrap">
      <noscript><p class="mb-8 border border-charcoal/20 p-4">The interactive planner needs JavaScript. The hotel list and links below still work.</p></noscript>
      <div class="mb-12 text-center md:mb-16"><p class="eyebrow">Where to stay</p><h2 class="display mt-4 text-[clamp(2.4rem,6vw,4.4rem)]">Find your <span class="italic-display">place</span></h2><p class="mx-auto mt-5 max-w-lg text-taupe">Choose a hotel on the map to see how far it is from {venue.name}, or let the planner build your weekend.</p></div>
      <TripConcierge client:visible data={data} />
      <noscript>
        <ul class="space-y-6">{hotels.map((h) => <li><p class="display text-2xl">{h.name}</p><p>{h.address}</p><p><a class="link" href={h.bookingUrl}>Official site</a> · <a class="link" href={h.googleDirections}>Directions</a></p></li>)}</ul>
      </noscript>
    </div>
  </section>

  <section id="stay-rentals" class="section">
    <div class="wrap grid gap-12 lg:grid-cols-12">
      <div class="reveal lg:col-span-4"><p class="eyebrow">Vacation rentals</p><h2 class="display mt-4 text-[clamp(2.4rem,5vw,4rem)]">Airbnb &amp; Vrbo</h2><p class="prose-soft mt-6">Searches centered on each area, set to the weekend of the wedding. Adjust dates and group size once the site opens.</p></div>
      <ul class="lg:col-span-8 divide-y divide-charcoal/15 border-y border-charcoal/15">
        {rentals.map((r) => (
          <li class="reveal grid items-center gap-3 py-6 md:grid-cols-[1fr_auto]">
            <div><p class="display text-3xl">{r.area}</p><p class="text-taupe">{r.note}</p></div>
            <p class="flex flex-wrap gap-3"><a class="btn !min-h-11" href={r.airbnb} target="_blank" rel="noopener noreferrer">Airbnb ↗</a><a class="btn !min-h-11" href={r.vrbo} target="_blank" rel="noopener noreferrer">Vrbo ↗</a></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="airports" class="bg-paper py-20 md:py-28">
    <div class="wrap">
      <div class="reveal"><p class="eyebrow">Flying in</p><h2 class="display mt-4 text-[clamp(2.4rem,5vw,4rem)]">Airports</h2></div>
      <div class="mt-14 grid gap-12 md:grid-cols-3">
        {airports.map((a, i) => {
          const code = a.code.split(' ')[0];
          const g: any = (geo.airportToVenue as any)[code];
          return (
            <article class="reveal">
              <p class="numeral text-[5rem] text-clay/80">{i + 1}</p>
              <p class="eyebrow mt-4">{a.role}</p>
              <h3 class="display mt-2 text-[2rem] leading-tight">{a.name}</h3>
              <p class="label mt-1">{a.code}</p>
              <p class="mt-4">{a.body}</p>
              {g && a.code.length === 3 && <p class="mt-3 text-sm text-taupe">About {g.miles} mi and {g.minutes} min to the venue (approximate, typical conditions).</p>}
              <p class="mt-3 flex flex-wrap gap-x-5 text-sm"><a class="tap link" href={a.href} target="_blank" rel="noopener noreferrer">{a.linkLabel} ↗</a>{a.extra?.map((e) => <a class="tap link" href={e.href} target="_blank" rel="noopener noreferrer">{e.label} ↗</a>)}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section id="cars" class="on-ink py-20 md:py-32">
    <div class="wrap grid gap-16 lg:grid-cols-2 lg:gap-24">
      <div>
        <div class="reveal"><p class="eyebrow">Getting around</p><h2 class="display mt-4 text-[clamp(2.4rem,5vw,4rem)]">Rental cars</h2></div>
        <p class="reveal mt-6 max-w-lg text-lg text-ivory/80">For most guests a rental car is the simplest plan. Escondido is spread out, the venue is a drive from town, and a car puts you in control of when you leave.</p>
        <ul class="reveal mt-6 space-y-3 text-ivory/80">{sanRentalFacts.map((f) => <li class="border-l border-sand/60 pl-4">{f}</li>)}</ul>
        <p class="reveal mt-8 flex flex-wrap gap-3">{rentalCompanies.map((c) => <a class="btn btn-light !min-h-11 !px-4" href={c.href} target="_blank" rel="noopener noreferrer">{c.name} ↗</a>)}</p>
        <p class="mt-3 text-xs text-ivory/60">Links go to each company’s own website. We haven’t checked prices or availability.</p>
      </div>
      <div>
        <div class="reveal"><p class="eyebrow">Without a car</p><h2 class="display mt-4 text-[clamp(2.4rem,5vw,4rem)]">Rides &amp; transit</h2></div>
        <div class="reveal mt-6 space-y-5 text-lg text-ivory/80">
          <p><strong class="font-medium text-ivory">Uber and Lyft</strong> work well getting to and from the airport and around Escondido. We can’t promise availability or wait times from the venue late in the evening, so plan your ride home in advance.</p>
          <p class="flex gap-6 text-sm"><a class="tap link" href={transit.rideshare.uber} target="_blank" rel="noopener noreferrer">Uber ↗</a><a class="tap link" href={transit.rideshare.lyft} target="_blank" rel="noopener noreferrer">Lyft ↗</a></p>
          <p><strong class="font-medium text-ivory">Public transit.</strong> {transit.sprinter.body}</p>
          <p><a class="tap link text-sm" href={transit.sprinter.href} target="_blank" rel="noopener noreferrer">NCTD SPRINTER ↗</a></p>
        </div>
      </div>
    </div>
  </section>

  <section id="shuttle" class="section">
    <div class="wrap grid gap-8 lg:grid-cols-12">
      <div class="reveal lg:col-span-5"><p class="eyebrow">Shuttle</p><h2 class="display mt-4 text-[clamp(2.4rem,5vw,4rem)]">Wedding shuttle</h2></div>
      <div class="reveal lg:col-span-6 lg:col-start-7 lg:self-end">
        {shuttle.arranged && shuttle.details ? <p class="prose-soft">{shuttle.details}</p> : <><ComingSoon>No shuttle has been arranged yet</ComingSoon><p class="mt-3 text-taupe">If the couple organizes one, the details will be posted here. Until then, please plan on your own transportation.</p></>}
      </div>
    </div>
  </section>

  <section id="tips" class="bg-paper py-20 md:py-28">
    <div class="wrap">
      <div class="reveal"><p class="eyebrow">Good to know</p><h2 class="display mt-4 text-[clamp(2.4rem,5vw,4rem)]">Wedding weekend tips</h2></div>
      <ol class="mt-12 grid gap-x-16 gap-y-10 md:grid-cols-2">
        {guidance.map((g, i) => <li class="reveal flex gap-6 border-t border-charcoal/20 pt-6"><span class="numeral text-4xl text-clay">{i + 1}</span><div><h3 class="display text-2xl">{g.t}</h3><p class="mt-2 text-taupe">{g.b}</p></div></li>)}
      </ol>
    </div>
  </section>

  <GuestConnect />
</Base>

---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import TripConcierge from '../components/trip/TripConcierge';
import GuestConnect from '../components/GuestConnect.astro';
import ComingSoon from '../components/ComingSoon.astro';
import { couple, venue, wedding, mapLinks, schedule, shuttle } from '../content/site';
import { hotels, rentals, stayDates, airports, rentalCompanies, sanRentalFacts, transit, guidance, travelIntro } from '../content/travel';
import geo from '../generated/geo.json';
import { groupUrl, groupGate } from '../lib/env';
import type { ConciergeData } from '../components/trip/types';

const hotelData = hotels.map((h) => ({
  ...h,
  lat: (geo.hotels as any)[h.id].lat, lon: (geo.hotels as any)[h.id].lon,
  toVenue: (geo.hotelToVenue as any)[h.id],
  fromAirport: Object.fromEntries(Object.keys(geo.airports).map((c) => [c, (geo.airportToHotel as any)[c][h.id]])),
}));
const notes: Record<string, string> = {
  SAN: 'Largest choice of flights, with a rental car center served by a free shuttle.',
  CRQ: 'Smaller and closer. Check airlines for current commercial service.',
  ONT: 'Alternative with a much longer drive.',
  SNA: 'Alternative with a much longer drive.',
  LAX: 'Most flights, and the longest drive.',
};
const airportData = Object.entries(geo.airports).map(([code, a]: [string, any]) => ({
  code, name: a.name, note: notes[code] ?? '', lat: a.lat, lon: a.lon,
  toVenue: (geo.airportToVenue as any)[code],
  toHotel: Object.fromEntries(hotels.map((h) => [h.id, (geo.airportToHotel as any)[code][h.id]])),
}));
const gUrl = groupUrl();
const groupPublic = groupGate() === 'public';
const data: ConciergeData = {
  hotels: hotelData as any,
  airports: airportData as any,
  venue: { name: venue.name, address: `${venue.street}, ${venue.city}, ${venue.region} ${venue.postal}`, lat: geo.venue.lat, lon: geo.venue.lon, googleDirections: mapLinks.googleDirections, appleDirections: mapLinks.appleDirections },
  couple: couple.display, dateISO: wedding.dateISO, dateLong: wedding.dateLong,
  schedule, stay: stayDates, rentals, rentalCompanies,
  routeMeta: { provider: geo.provider, date: geo.generatedAt, note: geo.note },
  group: { state: gUrl ? (groupPublic ? 'public' : 'gated') : 'none', url: gUrl && groupPublic ? gUrl : null },
  base: import.meta.env.BASE_URL.replace(/\/$/, ''),
};
---
<Base title="Plan Your Trip" description={`Hotels, airports, rental cars and directions for ${couple.display}'s wedding at ${venue.name} in ${wedding.cityLine}.`}>
  <section class="section pb-10">
    <div class="wrap grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <SectionHead as="h1" eyebrow="Travel" title="Plan your trip" />
        <p class="prose-soft reveal mt-8">{travelIntro}</p>
      </div>
      <nav aria-label="On this page" class="reveal self-end lg:col-span-4 lg:col-start-9">
        <ul class="space-y-2 text-sm">
          <li><a class="tap link" href="#concierge">Hotels, map &amp; trip planner</a></li>
          <li><a class="tap link" href="#airports">Airports</a></li>
          <li><a class="tap link" href="#cars">Rental cars &amp; rides</a></li>
          <li><a class="tap link" href="#shuttle">Shuttle</a></li>
          <li><a class="tap link" href="#tips">Weekend tips</a></li>
        </ul>
        <p class="mt-5 text-sm text-taupe">Just want directions? <a class="link" href={u("/details#directions")}>Go straight to the venue map.</a></p>
      </nav>
    </div>
  </section>

  <section id="concierge" class="section border-y border-charcoal/12 bg-paper pt-14">
    <div class="wrap">
      <noscript><p class="mb-8 border border-charcoal/20 p-4">The interactive planner needs JavaScript. The hotel list and links below still work.</p></noscript>
      <TripConcierge client:visible data={data} />
      <noscript>
        <ul class="space-y-6">{hotels.map((h) => <li><p class="display text-2xl">{h.name}</p><p>{h.address}</p><p><a class="tap link" href={h.bookingUrl}>Official site</a> · <a class="tap link" href={h.googleDirections}>Directions</a></p></li>)}</ul>
      </noscript>
    </div>
  </section>

  <section id="stay-rentals" class="section">
    <div class="wrap grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4"><SectionHead eyebrow="Vacation rentals" title="Airbnb &amp; Vrbo" /><p class="prose-soft reveal mt-6">Searches centered on each area, set to the weekend of the wedding. Adjust dates and group size once the site opens.</p></div>
      <ul class="lg:col-span-8 divide-y divide-charcoal/12 border-y border-charcoal/12">
        {rentals.map((r) => (
          <li class="reveal grid items-center gap-3 py-6 md:grid-cols-[1fr_auto]">
            <div><p class="display text-2xl">{r.area}</p><p class="text-taupe">{r.note}</p></div>
            <p class="flex flex-wrap gap-3"><a class="btn !min-h-11" href={r.airbnb} target="_blank" rel="noopener noreferrer">Airbnb ↗</a><a class="btn !min-h-11" href={r.vrbo} target="_blank" rel="noopener noreferrer">Vrbo ↗</a></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="airports" class="section border-t border-charcoal/12">
    <div class="wrap">
      <SectionHead eyebrow="Flying in" title="Airports" />
      <div class="mt-12 grid gap-10 md:grid-cols-3">
        {airports.map((a) => {
          const code = a.code.split(' ')[0];
          const g: any = (geo.airportToVenue as any)[code];
          return (
            <article class="reveal border-t border-charcoal/20 pt-6">
              <p class="eyebrow">{a.role}</p>
              <h3 class="display mt-3 text-3xl">{a.name}</h3>
              <p class="label mt-1">{a.code}</p>
              <p class="mt-4">{a.body}</p>
              {g && a.code.length === 3 && <p class="mt-3 text-sm text-taupe">About {g.miles} mi and {g.minutes} min to the venue (estimate, typical conditions).</p>}
              <p class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm"><a class="tap link" href={a.href} target="_blank" rel="noopener noreferrer">{a.linkLabel} ↗</a>{a.extra?.map((e) => <a class="tap link" href={e.href} target="_blank" rel="noopener noreferrer">{e.label} ↗</a>)}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section id="cars" class="section border-t border-charcoal/12 bg-paper">
    <div class="wrap grid gap-14 lg:grid-cols-2">
      <div>
        <SectionHead eyebrow="Getting around" title="Rental cars" />
        <p class="prose-soft reveal mt-6">For most guests a rental car is the simplest plan. Escondido is spread out, the venue is a drive from town, and a car puts you in control of when you leave.</p>
        <ul class="reveal mt-6 space-y-3">{sanRentalFacts.map((f) => <li class="border-l border-sand pl-4">{f}</li>)}</ul>
        <p class="reveal mt-8 flex flex-wrap gap-3">{rentalCompanies.map((c) => <a class="btn !min-h-11 !px-4" href={c.href} target="_blank" rel="noopener noreferrer">{c.name} ↗</a>)}</p>
        <p class="mt-3 text-xs text-taupe">Links go to each company’s own website. We haven’t checked prices or availability.</p>
      </div>
      <div>
        <SectionHead eyebrow="Without a car" title="Rides &amp; transit" />
        <div class="reveal mt-6 space-y-5">
          <p class="prose-soft"><strong class="font-medium">Uber and Lyft</strong> work well getting to and from the airport and around Escondido. We can’t promise availability or wait times from the venue late in the evening, so plan your ride home in advance.</p>
          <p class="flex gap-5 text-sm"><a class="tap link" href={transit.rideshare.uber} target="_blank" rel="noopener noreferrer">Uber ↗</a><a class="tap link" href={transit.rideshare.lyft} target="_blank" rel="noopener noreferrer">Lyft ↗</a></p>
          <p class="prose-soft"><strong class="font-medium">Public transit.</strong> {transit.sprinter.body}</p>
          <p><a class="tap link text-sm" href={transit.sprinter.href} target="_blank" rel="noopener noreferrer">NCTD SPRINTER ↗</a></p>
        </div>
      </div>
    </div>
  </section>

  <section id="shuttle" class="section border-t border-charcoal/12">
    <div class="wrap grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-5"><SectionHead eyebrow="Shuttle" title="Wedding shuttle" /></div>
      <div class="reveal lg:col-span-6 lg:col-start-7">
        {shuttle.arranged && shuttle.details ? <p class="prose-soft">{shuttle.details}</p> : <><ComingSoon>No shuttle has been arranged yet</ComingSoon><p class="mt-3 text-taupe">If the couple organizes one, the details will be posted here. Until then, please plan on your own transportation.</p></>}
      </div>
    </div>
  </section>

  <section id="tips" class="section border-t border-charcoal/12 bg-paper">
    <div class="wrap">
      <SectionHead eyebrow="Good to know" title="Wedding weekend tips" />
      <div class="mt-12 grid gap-10 md:grid-cols-2">
        {guidance.map((g) => <div class="reveal border-t border-charcoal/20 pt-5"><h3 class="display text-2xl">{g.t}</h3><p class="mt-2 text-taupe">{g.b}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section"><div class="wrap max-w-4xl"><GuestConnect /></div></section>
</Base>

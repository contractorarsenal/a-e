---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
import TripConcierge from '../components/trip/TripConcierge';
import GuestConnect from '../components/GuestConnect.astro';
import ComingSoon from '../components/ComingSoon.astro';
import { couple, venue, wedding, mapLinks, schedule, shuttle } from '../content/site';
import { hotels, rentals, stayDates, airports, rentalCompanies, sanRentalFacts, transit, guidance, travelIntro } from '../content/travel';
import geo from '../generated/geo.json';
import { groupUrl, groupGate } from '../lib/env';
import type { ConciergeData } from '../components/trip/types';

const hotelData = hotels.map((h) => ({
  ...h,
  lat: (geo.hotels as any)[h.id].lat, lon: (geo.hotels as any)[h.id].lon,
  toVenue: (geo.hotelToVenue as any)[h.id],
  fromAirport: Object.fromEntries(Object.keys(geo.airports).map((c) => [c, (geo.airportToHotel as any)[c][h.id]])),
})).sort((a: any, b: any) => a.toVenue.minutes - b.toVenue.minutes);
const notes: Record<string, string> = {
  SAN: 'Largest choice of flights, with a rental car center served by a free shuttle.',
  CRQ: 'Smaller and closer. Check airlines for current commercial service.',
  ONT: 'Alternative with a much longer drive.',
  SNA: 'Alternative with a much longer drive.',
  LAX: 'Most flights, and the longest drive.',
};
const airportData = Object.entries(geo.airports).map(([code, a]: [string, any]) => ({
  code, name: a.name, note: notes[code] ?? '', lat: a.lat, lon: a.lon,
  toVenue: (geo.airportToVenue as any)[code],
  toHotel: Object.fromEntries(hotels.map((h) => [h.id, (geo.airportToHotel as any)[code][h.id]])),
}));
const gUrl = groupUrl();
const groupPublic = groupGate() === 'public';
const data: ConciergeData = {
  hotels: hotelData as any,
  airports: airportData as any,
  venue: { name: venue.name, address: `${venue.street}, ${venue.city}, ${venue.region} ${venue.postal}`, lat: geo.venue.lat, lon: geo.venue.lon, googleDirections: mapLinks.googleDirections, appleDirections: mapLinks.appleDirections },
  couple: couple.display, dateISO: wedding.dateISO, dateLong: wedding.dateLong,
  schedule, stay: stayDates, rentals, rentalCompanies,
  routeMeta: { provider: geo.provider, date: geo.generatedAt, note: geo.note },
  group: { state: gUrl ? (groupPublic ? 'public' : 'gated') : 'none', url: gUrl && groupPublic ? gUrl : null },
  base: import.meta.env.BASE_URL.replace(/\/$/, ''),
};
const sanFromHotel = (id: string) => (geo.airportToHotel as any).SAN[id];
---
<Base title="Travel & Stay" description={`Where to stay, airports and getting around for ${couple.display}'s wedding at ${venue.name} in ${wedding.cityLine}.`}>
  <div class="wrap pb-6 pt-10 md:pt-16">
    <h1 class="display text-[clamp(2.6rem,8vw,5rem)]">Travel &amp; Stay</h1>
    <p class="prose-soft mt-5">{travelIntro}</p>
  </div>

  <!-- 1. Where to stay -->
  <section id="stay" class="wrap mt-10 md:mt-14" aria-labelledby="stay-h">
    <h2 id="stay-h" class="display text-[clamp(1.8rem,4vw,2.6rem)]">Where to stay</h2>
    <p class="mt-3 max-w-xl text-taupe">Listed by approximate drive time to {venue.name}. We have not checked availability or prices, so please look at each hotel’s own site for your dates.</p>
    <ol class="mt-8 border-t border-charcoal/20">
      {hotelData.map((h: any) => (
        <li class="border-b border-charcoal/20 py-7 md:py-9">
          <div class="grid gap-5 md:grid-cols-[1fr_auto] md:gap-12">
            <div>
              <h3 class="display text-[clamp(1.45rem,3vw,1.9rem)] leading-tight">{h.name}</h3>
              <p class="mt-1 text-taupe">{h.tier} · {h.area}</p>
              <p class="mt-3 max-w-md">{h.why}</p>
            </div>
            <p class="md:text-right">
              <span class="numeral block text-[2.2rem] md:text-[2.6rem]">{h.toVenue.miles} mi</span>
              <span class="block text-lg">about {h.toVenue.minutes} min drive</span>
              <span class="block text-sm text-taupe">to {venue.name} · approximate</span>
            </p>
          </div>
          <div class="mt-5 flex flex-wrap gap-3">
            <a class="btn btn-solid" href={h.bookingUrl} target="_blank" rel="noopener noreferrer">Book hotel ↗</a>
            <a class="btn" href={h.googleDirections} target="_blank" rel="noopener noreferrer">Directions ↗</a>
          </div>
          <details class="disclose mt-4">
            <summary class="tap inline-flex items-center gap-2 text-sm"><span class="plus text-lg leading-none text-clay" aria-hidden="true">+</span> More about this hotel</summary>
            <div class="mt-3 grid gap-x-10 gap-y-4 text-sm md:grid-cols-2">
              <p><span class="label">Address</span>{h.address}</p>
              <p><span class="label">From San Diego airport (SAN)</span>{sanFromHotel(h.id).miles} mi · about {sanFromHotel(h.id).minutes} min, approximate</p>
              <p><span class="label">Rooms</span>{h.roomTypes}</p>
              <p><span class="label">Kitchen</span>{h.kitchen}</p>
              <p><span class="label">Good for</span>{h.family}</p>
              <p><span class="label">Parking</span>{h.parking}</p>
              <p class="md:col-span-2"><span class="label">Amenities as reported</span>{h.amenities.join(' · ')}. Please confirm on the hotel’s own page.</p>
              <p class="md:col-span-2"><a class="link tap" href={h.appleDirections} target="_blank" rel="noopener noreferrer">Directions in Apple Maps ↗</a></p>
            </div>
          </details>
        </li>
      ))}
    </ol>
    <p class="mt-5 max-w-2xl text-sm text-taupe">Drive times are approximate, from road data under typical conditions with no traffic ({geo.provider}, {geo.generatedAt}). Booking links open the hotel’s own website; nothing is reserved until you book there, and this site never takes payments. <button type="button" class="link tap" data-open-tools>See them on a map and compare →</button></p>
  </section>

  <!-- 2. Airports and getting around -->
  <section id="airports" class="wrap mt-16 md:mt-24" aria-labelledby="air-h">
    <h2 id="air-h" class="display text-[clamp(1.8rem,4vw,2.6rem)]">Airports &amp; getting around</h2>
    <div class="mt-8 grid gap-10 border-t border-charcoal/20 pt-8 md:grid-cols-2 md:gap-16">
      <div id="airport-info">
        <h3 class="display text-2xl">Flying in</h3>
        <p class="mt-3"><strong class="font-medium">San Diego International (SAN)</strong> has the most flights. It is about {(geo.airportToVenue as any).SAN.miles} road miles from the venue, roughly {(geo.airportToVenue as any).SAN.minutes} minutes (approximate).</p>
        <p class="mt-3"><strong class="font-medium">McClellan-Palomar (CRQ)</strong> in Carlsbad is closer, about {(geo.airportToVenue as any).CRQ.miles} miles. Commercial service there is limited and has changed over time, so check with the airlines.</p>
        <details class="disclose mt-3">
          <summary class="tap inline-flex items-center gap-2 text-sm"><span class="plus text-lg leading-none text-clay" aria-hidden="true">+</span> Other airports</summary>
          <p class="mt-2 text-sm text-taupe">Ontario (ONT), Orange County (SNA) and Los Angeles (LAX) can have more flight options but are a much longer drive. Approximate road distance to the venue: ONT {(geo.airportToVenue as any).ONT.miles} mi, SNA {(geo.airportToVenue as any).SNA.miles} mi, LAX {(geo.airportToVenue as any).LAX.miles} mi.</p>
          <p class="mt-2 flex flex-wrap gap-x-5 text-sm"><a class="tap link" href="https://www.flyontario.com" target="_blank" rel="noopener noreferrer">Ontario ↗</a><a class="tap link" href="https://www.ocair.com" target="_blank" rel="noopener noreferrer">Orange County ↗</a><a class="tap link" href="https://www.flylax.com" target="_blank" rel="noopener noreferrer">LAX ↗</a><a class="tap link" href="https://www.sandiegocounty.gov/content/sdc/dpw/airports/palomar.html" target="_blank" rel="noopener noreferrer">Palomar airport info ↗</a></p>
        </details>
      </div>
      <div id="cars">
        <h3 class="display text-2xl">Cars, rides &amp; transit</h3>
        <p class="mt-3">{sanRentalFacts[0]} {sanRentalFacts[1]}</p>
        <p class="mt-3">Rideshare (<a class="link" href={transit.rideshare.uber} target="_blank" rel="noopener noreferrer">Uber</a>, <a class="link" href={transit.rideshare.lyft} target="_blank" rel="noopener noreferrer">Lyft</a>) works for the airport and around town. We can’t promise availability from the venue late in the evening, so please plan your ride back.</p>
        <details class="disclose mt-3">
          <summary class="tap inline-flex items-center gap-2 text-sm"><span class="plus text-lg leading-none text-clay" aria-hidden="true">+</span> Rental car companies and public transit</summary>
          <p class="mt-3 flex flex-wrap gap-x-5 text-sm">{rentalCompanies.map((c) => <a class="tap link" href={c.href} target="_blank" rel="noopener noreferrer">{c.name} ↗</a>)}</p>
          <p class="mt-2 text-xs text-taupe">Links go to each company’s own website. We haven’t checked prices or availability.</p>
          <p class="mt-4 text-sm">{transit.sprinter.body} <a class="link tap" href={transit.sprinter.href} target="_blank" rel="noopener noreferrer">NCTD SPRINTER ↗</a></p>
        </details>
      </div>
    </div>
    <ul class="mt-10 grid gap-x-12 gap-y-3 border-t border-charcoal/20 pt-6 text-taupe md:grid-cols-2">
      {guidance.map((g) => <li><strong class="font-medium text-charcoal">{g.t}.</strong> {g.b}</li>)}
    </ul>
  </section>

  <!-- 3. Airbnb / Vrbo -->
  <section id="stay-rentals" class="wrap mt-16 md:mt-24" aria-labelledby="rent-h">
    <h2 id="rent-h" class="display text-[clamp(1.8rem,4vw,2.6rem)]">Airbnb &amp; Vrbo</h2>
    <p class="mt-3 max-w-xl text-taupe">Searches for each area, set to the wedding weekend. Change the dates and group size on their sites.</p>
    <ul class="mt-6 border-t border-charcoal/20">
      {rentals.map((r) => (
        <li class="flex flex-wrap items-center justify-between gap-x-8 gap-y-1 border-b border-charcoal/20 py-4">
          <p><span class="display text-xl">{r.area}</span><span class="ml-3 text-sm text-taupe">{r.note}</span></p>
          <p class="flex gap-5 text-sm"><a class="tap link" href={r.airbnb} target="_blank" rel="noopener noreferrer">Airbnb ↗</a><a class="tap link" href={r.vrbo} target="_blank" rel="noopener noreferrer">Vrbo ↗</a></p>
        </li>
      ))}
    </ul>
  </section>

  <!-- 4. Shuttle + travel together -->
  <section id="together" class="wrap mt-16 md:mt-24">
    <div class="grid gap-10 border-t border-charcoal/20 pt-8 md:grid-cols-2 md:gap-16">
      <div id="shuttle">
        <h2 class="display text-2xl">Shuttle</h2>
        <div class="mt-3">{shuttle.arranged && shuttle.details ? <p>{shuttle.details}</p> : <ComingSoon>Shuttle information, if any, will be posted here</ComingSoon>}</div>
      </div>
      <GuestConnect />
    </div>
  </section>

  <!-- 5. Optional tools (collapsed) -->
  <section id="trip-tools" class="wrap mt-16 md:mt-24" aria-labelledby="tools-h">
    <details class="disclose border border-charcoal/25 bg-paper" data-tools>
      <summary class="flex min-h-[4.5rem] items-center justify-between gap-6 px-5 py-4 md:px-8">
        <span><span id="tools-h" class="display block text-[clamp(1.4rem,3vw,1.9rem)]">Map, compare &amp; trip planner</span><span class="mt-1 block text-sm text-taupe">Optional: see the hotels on a map, compare them, plan your weekend, estimate costs</span></span>
        <span class="plus text-2xl text-clay" aria-hidden="true">+</span>
      </summary>
      <div class="border-t border-charcoal/15 px-5 py-8 md:px-8 md:py-12">
        <noscript><p class="mb-4 border border-charcoal/20 p-4">The planner needs JavaScript. The hotel list above works without it.</p></noscript>
        <TripConcierge client:visible data={data} />
      </div>
    </details>
  </section>
</Base>

<script>
  // Open the optional tools from links ("See them on a map") or a #trip-tools URL.
  const tools = document.querySelector<HTMLDetailsElement>('[data-tools]');
  const openTools = () => { if (tools) { tools.open = true; tools.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' }); } };
  document.querySelectorAll('[data-open-tools]').forEach((b) => b.addEventListener('click', openTools));
  if (location.hash === '#trip-tools' || location.hash === '#concierge') { if (tools) tools.open = true; }
</script>

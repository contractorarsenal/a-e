---
import Base from '../layouts/Base.astro';
import { faq } from '../content/site';
import { u } from '../lib/url';
---
<Base title="Questions" description="Answers to common questions about the wedding.">
  <div class="wrap pb-6 pt-10 md:pt-16">
    <h1 class="display text-[clamp(2.6rem,8vw,5rem)]">Questions</h1>
    <p class="mt-4 max-w-xl text-taupe">Anything that is still being decided says so, and we’ll fill it in once it’s confirmed.</p>
    <div class="mt-10 max-w-3xl divide-y divide-charcoal/15 border-y border-charcoal/15">
      {faq.map((f) => (
        <details class="disclose">
          <summary class="flex min-h-[3.75rem] items-center justify-between gap-6 py-3">
            <span class="display text-[1.3rem] leading-snug md:text-[1.5rem]">{f.q}</span>
            <span class="plus text-2xl text-clay" aria-hidden="true">+</span>
          </summary>
          <div class="pb-6 pr-8">
            {f.a ? <p class="prose-soft">{f.a}</p> : <p class="italic text-taupe">To be confirmed.</p>}
            {f.link && f.a && <p class="mt-2"><a class="link tap text-sm" href={u(f.link.href)}>{f.link.label} →</a></p>}
          </div>
        </details>
      ))}
    </div>
  </div>
</Base>

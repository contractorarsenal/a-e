---
import Base from '../layouts/Base.astro';
import Picture from '../components/Picture.astro';
import Countdown from '../components/Countdown.astro';
import Optional from '../components/Optional.astro';
import { wedding, venue } from '../content/site';
import { photos } from '../lib/photos';
import { u } from '../lib/url';

const plates = [
  { slug: 'proposal-moment', n: 'I', pos: '50% 46%', cls: '' },
  { slug: 'proposal-laughing', n: 'II', pos: '55% 42%', cls: '' },
  { slug: 'proposal-kiss', n: 'III', pos: '50% 40%', cls: 'hidden md:block' },
] as const;
const ways = [
  { href: '/details', t: 'The Wedding', d: 'Date, venue, directions and the schedule' },
  { href: '/travel', t: 'Travel & Stay', d: 'Hotels with drive times, airports and rides' },
  { href: '/faq', t: 'Questions', d: 'Answers to the things guests ask most' },
];
---
<Base>
  <!-- The invitation -->
  <section class="wrap pb-2 pt-8 text-center md:pt-12" aria-labelledby="names">
    <p class="text-taupe">We’re getting married</p>
    <h1 id="names" class="display mt-3 text-[clamp(3.4rem,17vw,6.5rem)] leading-[.95] sm:text-[clamp(3.4rem,9vw,6.5rem)] sm:leading-none"><span class="block sm:inline">Adrian</span> <span class="italic-display">&amp;</span> Emma</h1>
    <div class="mx-auto mt-6 h-px w-16 bg-charcoal/30" aria-hidden="true"></div>
    <p class="mt-6 text-[.84rem] font-medium uppercase tracking-[.2em]">{wedding.dateLong}</p>
    <p class="mt-1.5 text-lg">{venue.name} · {wedding.cityLine}</p>
    <p class="mt-6"><a href={u('/rsvp')} class="btn btn-solid">RSVP</a></p>
    <p class="mt-4 text-sm text-taupe"><Countdown /></p>
  </section>

  <!-- The photograph -->
  <section class="wrap mt-8 md:mt-10" aria-label="Photograph">
    <figure class="mx-auto max-w-[34rem]">
      <div class="aspect-[3/4] overflow-hidden bg-champagne">
        <Picture slug="proposal-hands" alt={photos['proposal-hands'].alt} loading="eager" sizes="(min-width:768px) 544px, calc(100vw - 2.5rem)" position="50% 45%" />
      </div>
      <figcaption class="mt-3 text-center italic-display text-taupe">{photos['proposal-hands'].caption}</figcaption>
    </figure>
  </section>

  <!-- A short series -->
  <section class="wrap mt-20 md:mt-32" aria-labelledby="series">
    <div class="flex items-baseline justify-between gap-6 border-t border-charcoal/20 pt-4">
      <h2 id="series" class="text-taupe">The day we got engaged</h2>
      <a href={u('/story')} class="link tap text-sm">Our story →</a>
    </div>
    <div class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-6">
      {plates.map((p) => (
        <figure class={`reveal ${p.cls}`}>
          <div class="aspect-[3/4] overflow-hidden bg-champagne"><Picture slug={p.slug} alt={photos[p.slug].alt} sizes="(min-width:768px) 30vw, 46vw" position={p.pos} /></div>
          <figcaption class="mt-2 text-sm text-taupe"><span class="numeral mr-2 text-clay">{p.n}</span><span class="italic-display">{photos[p.slug].caption}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- Where to go next -->
  <nav class="wrap mt-20 md:mt-32" aria-label="Wedding information">
    <ul class="border-t border-charcoal/20">
      {ways.map((w) => (
        <li class="border-b border-charcoal/20">
          <a href={u(w.href)} class="group flex min-h-20 items-center justify-between gap-6 py-5 no-underline">
            <span><span class="display block text-[clamp(1.6rem,4vw,2.4rem)]">{w.t}</span><span class="mt-1 block text-taupe">{w.d}</span></span>
            <span aria-hidden="true" class="text-2xl transition-transform duration-300 group-hover:translate-x-1">→</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <Optional />
</Base>

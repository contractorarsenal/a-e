---
/**
 * "/" is the first-visit language chooser. Returning visitors (saved choice in localStorage) are sent straight to
 * their language before anything paints. Nothing here guesses a language from location or browser settings.
 * Without JavaScript the two links in <noscript> still work.
 */
import '../styles/global.css';
import { u } from '../lib/url';
import { visibility } from '../lib/env';
import { en } from '../i18n/en';
import { esMX } from '../i18n/es-MX';
import { pageSlugs } from '../content/site';
import { wedding, venue } from '../content/site';
import { dateLong } from '../i18n/format';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const index = visibility() === 'public';
const opts = [
  { code: 'en', lang: 'en', label: en.localeLabel, d: en },
  { code: 'es', lang: 'es-MX', label: esMX.localeLabel, d: esMX },
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Adrian &amp; Emma · Choose your language · Elige tu idioma</title>
    <meta name="description" content={`${dateLong(wedding.dateISO, 'en')} · ${dateLong(wedding.dateISO, 'es')} · ${venue.name}, ${wedding.cityLine}`} />
    <meta name="theme-color" content="#f5f0e6" />
    {!index && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={new URL(u('/'), Astro.site).href} />
    <link rel="alternate" hreflang="en" href={new URL(u('/en/'), Astro.site).href} />
    <link rel="alternate" hreflang="es-MX" href={new URL(u('/es/'), Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(u('/'), Astro.site).href} />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content="Adrian &amp; Emma" />
    <meta property="og:image" content={new URL(u('/img/og.jpg'), Astro.site).href} />
    <script is:inline define:vars={{ BASE: base, SLUGS: pageSlugs }}>
      // Returning visitors go straight to their saved language (before first paint, so the chooser never flashes).
      (function () {
        try {
          var l = localStorage.getItem('ae-lang');
          if (l === 'en' || l === 'es') {
            var n = (new URLSearchParams(location.search).get('next') || '').replace(/\//g, '');
            var path = SLUGS.indexOf(n) > -1 ? n + '/' : '';
            document.documentElement.className += ' go';
            location.replace(BASE + '/' + l + '/' + path);
          }
        } catch (e) {}
      })();
    </script>
    <style is:global>html.go body { visibility: hidden; }</style>
  </head>
  <body>
    <main id="main" class="grid min-h-svh place-items-center px-5 py-12">
      <div class="w-full max-w-md text-center">
        <h1 class="display text-[clamp(3.4rem,17vw,5.5rem)] leading-[.95]"><span class="block sm:inline">Adrian</span> <span class="italic-display">&amp;</span> Emma</h1>
        <div class="mx-auto mt-7 h-px w-16 bg-charcoal/40" aria-hidden="true"></div>

        <form id="chooser" class="mt-8" novalidate>
          <fieldset>
            <legend class="w-full">
              <span lang="en" class="italic-display block text-[1.6rem] leading-tight">{en.chooser.choose}</span>
              <span lang="es-MX" class="italic-display mt-1 block text-[1.6rem] leading-tight">{esMX.chooser.choose}</span>
            </legend>
            <div class="mt-6 grid gap-3 text-left">
              {opts.map((o) => (
                <label class="flex min-h-[4.5rem] cursor-pointer items-center gap-4 border-[1.5px] border-line bg-paper px-5 text-[1.4rem] font-semibold has-[:checked]:border-charcoal has-[:checked]:bg-champagne/50 has-[:focus-visible]:outline has-[:focus-visible]:outline-[3px] has-[:focus-visible]:outline-clay">
                  <input type="radio" name="lang" value={o.code} class="check !h-6 !w-6" />
                  <span lang={o.lang}>{o.label}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <p id="msg" role="alert" class="mt-4 min-h-[1.5rem] font-semibold text-error"></p>
          <button type="submit" class="btn btn-solid mt-2 w-full !min-h-14 !text-[1.15rem]">
            <span id="go-label"><span lang="en">{en.chooser.continue}</span> / <span lang="es-MX">{esMX.chooser.continue}</span></span>
          </button>
        </form>

        <noscript>
          <p class="mt-8 text-taupe"><span lang="en">{en.chooser.noscript}</span><br /><span lang="es-MX">{esMX.chooser.noscript}</span></p>
          <p class="mt-3 flex justify-center gap-6"><a class="link tap" lang="en" href={u('/en/')}>{en.localeLabel}</a><a class="link tap" lang="es-MX" href={u('/es/')}>{esMX.localeLabel}</a></p>
        </noscript>
      </div>
    </main>

    <script is:inline define:vars={{ BASE: base, SLUGS: pageSlugs, EN: en.chooser, ES: esMX.chooser }}>
      var form = document.getElementById('chooser');
      var msg = document.getElementById('msg');
      var label = document.getElementById('go-label');
      var T = { en: EN, es: ES };
      var attr = { en: 'en', es: 'es-MX' };
      form.addEventListener('change', function () {
        var v = form.elements.lang.value;
        if (!v) return;
        msg.textContent = '';
        label.innerHTML = '';
        var s = document.createElement('span'); s.lang = attr[v]; s.textContent = T[v].continue; label.appendChild(s);
      });
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var v = form.elements.lang.value;
        if (!v) {
          msg.innerHTML = '';
          ['en', 'es'].forEach(function (k) { var s = document.createElement('span'); s.lang = attr[k]; s.className = 'block'; s.textContent = T[k].pick; msg.appendChild(s); });
          form.querySelector('input').focus();
          return;
        }
        try { localStorage.setItem('ae-lang', v); } catch (err) {}
        var n = (new URLSearchParams(location.search).get('next') || '').replace(/\//g, '');
        location.href = BASE + '/' + v + '/' + (SLUGS.indexOf(n) > -1 ? n + '/' : '');
      });
    </script>
  </body>
</html>

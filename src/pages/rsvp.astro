---
import Base from '../layouts/Base.astro';
import RsvpForm from '../components/RsvpForm.astro';
import { rsvpEndpoint, groupUrl } from '../lib/env';
import { rsvp, couple, contact } from '../content/site';
const endpoint = rsvpEndpoint();
---
<Base title="RSVP" description={`Reply to ${couple.display}'s wedding invitation.`}>
  <div class="wrap max-w-2xl pb-6 pt-10 md:pt-16">
    <h1 class="display text-[clamp(2.6rem,8vw,5rem)]">RSVP</h1>
    {endpoint && rsvp.deadline && <p class="mt-4 text-taupe">Kindly reply by {rsvp.deadline}.</p>}
    <div class="mt-10">
      {endpoint ? <RsvpForm endpoint={endpoint} groupUrl={groupUrl() ?? ''} deadlineISO={rsvp.deadlineISO ?? ''} maxAdditional={rsvp.maxAdditionalGuests} /> : (
        <div class="border-y border-charcoal/20 py-10">
          <p class="display text-3xl">The RSVP form isn’t open yet.</p>
          <p class="mt-3 max-w-md text-taupe">Replies are not being accepted on this site right now. Please check back, or wait for word from Adrian and Emma.</p>
        </div>
      )}
      {contact.email && <p class="mt-8 text-sm text-taupe">Questions? <a class="link" href={`mailto:${contact.email}`}>{contact.email}</a></p>}
    </div>
  </div>
</Base>

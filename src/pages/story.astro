---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import { story, couple } from '../content/site';
import { u } from '../lib/url';
---
<Base title="Our Story" description={`The story of ${couple.display}, told in the photographs from the day they got engaged.`}>
  <div class="wrap pb-4 pt-10 md:pt-16">
    <h1 class="display text-[clamp(2.6rem,8vw,5rem)]">Our Story</h1>
    <p class="display mt-8 max-w-3xl text-[clamp(1.5rem,3.2vw,2.2rem)] leading-snug">{story.intro}</p>
    {story.chapters.length > 0 && (
      <div class="mt-12 max-w-2xl space-y-10">
        {story.chapters.map((c) => <div><h2 class="display text-2xl">{c.title}</h2><p class="prose-soft mt-3">{c.body}</p></div>)}
      </div>
    )}
  </div>

  <section class="wrap mt-14 md:mt-20" aria-labelledby="gal">
    <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-1 border-t border-charcoal/20 pt-4">
      <h2 id="gal" class="text-taupe">The day we got engaged</h2>
      <p class="text-sm text-taupe">Tap a photo to view it larger.</p>
    </div>
    <div class="mt-8"><Gallery /></div>
  </section>

  <p class="wrap mt-16 flex flex-wrap gap-x-8 text-sm"><a class="link tap" href={u('/details')}>The Wedding</a><a class="link tap" href={u('/rsvp')}>RSVP</a></p>
</Base>

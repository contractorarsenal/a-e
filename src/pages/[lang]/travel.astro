---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import TripConcierge from '../../components/trip/TripConcierge';
import GuestConnect from '../../components/GuestConnect.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import { couple, venue, wedding, mapLinks, schedule, shuttle } from '../../content/site';
import { hotels, rentals, stayDates, rentalCompanies, links } from '../../content/travel';
import geo from '../../generated/geo.json';
import { groupUrl, groupGate } from '../../lib/env';
import { useLang, fmt, mi, dur, dateShort, dateLong, tx } from '../../i18n';
import type { ConciergeData } from '../../components/trip/types';

export const getStaticPaths = () => [{ params: { lang: 'en' } }, { params: { lang: 'es' } }];
const { lang, t, l } = useLang(Astro);
const T = t.travel;

// Hotel text comes from the dictionary for this language; ids, addresses and links are language-neutral.
const hotelData = hotels.map((h) => ({
  ...h, ...t.hotels[h.id],
  lat: (geo.hotels as any)[h.id].lat, lon: (geo.hotels as any)[h.id].lon,
  toVenue: (geo.hotelToVenue as any)[h.id],
  fromAirport: Object.fromEntries(Object.keys(geo.airports).map((c) => [c, (geo.airportToHotel as any)[c][h.id]])),
})).sort((a: any, b: any) => a.toVenue.minutes - b.toVenue.minutes);
const airportData = Object.entries(geo.airports).map(([code, a]: [string, any]) => ({
  code, name: (T.airportNames as Record<string, string>)[code] ?? a.name, note: (T.airportNotes as Record<string, string>)[code] ?? '', lat: a.lat, lon: a.lon,
  toVenue: (geo.airportToVenue as any)[code],
  toHotel: Object.fromEntries(hotels.map((h) => [h.id, (geo.airportToHotel as any)[code][h.id]])),
}));
const gUrl = groupUrl();
const groupPublic = groupGate() === 'public';
const routeDate = dateShort(geo.generatedAt, lang);
const data: ConciergeData = {
  lang, t: t.trip, newTab: t.newTab,
  hotels: hotelData as any,
  airports: airportData as any,
  venue: { name: venue.name, address: `${venue.street}, ${venue.city}, ${venue.region} ${venue.postal}`, lat: geo.venue.lat, lon: geo.venue.lon, googleDirections: mapLinks.googleDirections, appleDirections: mapLinks.appleDirections },
  couple: couple.display, dateISO: wedding.dateISO, dateLong: dateLong(wedding.dateISO, lang),
  schedule: schedule.map((s) => ({ time: s.time, title: tx(s.title, lang), note: s.note ? tx(s.note, lang) : undefined })),
  stay: stayDates,
  rentals: rentals.map((r) => ({ ...r, note: (T.rentalNotes as Record<string, string>)[r.id] })),
  rentalCompanies: rentalCompanies.map((c) => ({ name: c.kayak ? T.compareKayak : c.name, href: c.href })),
  routeMeta: { source: T.routeSource, date: routeDate, note: T.routeNote },
  group: { state: gUrl ? (groupPublic ? 'public' : 'gated') : 'none', url: gUrl && groupPublic ? gUrl : null },
  rsvpHref: l('/rsvp'), rsvpVerb: t.nav.rsvpVerb, stayTab: t.trip.tabStay,
};
const sanFromHotel = (id: string) => (geo.airportToHotel as any).SAN[id];
const ato = geo.airportToVenue as Record<string, { miles: number; minutes: number }>;
const NT = `<span class="sr-only"> ${t.newTab}</span>`;
const ext = (href: string, label: string) => `<a class="tap link" href="${href}" target="_blank" rel="noopener noreferrer">${label} ↗${NT}</a>`;
---
<Base title={t.nav.travel} description={fmt(t.meta.travelDesc, { couple: couple.display, venue: venue.name, city: wedding.cityLine })}>
  <PageHead title={t.nav.travel} />

  <!-- 1. Where to stay -->
  <section id="stay" class="wrap mt-10 md:mt-12" aria-labelledby="stay-h">
    <h2 id="stay-h" class="h2">{T.stayH}</h2>
    <p class="mt-3 max-w-xl text-taupe">{fmt(T.stayNote, { venue: venue.name })}</p>
    <ol class="mt-8 border-t border-charcoal/25">
      {hotelData.map((h: any) => (
        <li class="border-b border-charcoal/25 py-7 md:py-9">
          <h3 class="h3 md:text-[1.625rem]">{h.name}</h3>
          <p class="mt-2 text-[1.25rem] font-bold">{fmt(T.driveLine, { t: dur(h.toVenue.minutes, lang), d: mi(h.toVenue.miles, lang) })}</p>
          <p class="text-taupe">{fmt(T.toVenueApprox, { venue: venue.name })}</p>
          <p class="mt-3"><span class="sr-only">{T.address}: </span>{h.address}</p>
          <p class="mt-3 max-w-xl text-taupe">{h.why}</p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a class="btn btn-solid" href={h.bookingUrl} target="_blank" rel="noopener noreferrer">{T.book} ↗<span class="sr-only"> {h.name}, {t.newTab}</span></a>
            <a class="btn" href={h.googleDirections} target="_blank" rel="noopener noreferrer">{T.directions} ↗<span class="sr-only"> {h.name}, {t.newTab}</span></a>
          </div>
          <details class="disclose mt-4">
            <summary class="tap inline-flex items-center gap-2 font-semibold"><span class="plus text-2xl leading-none text-clay" aria-hidden="true">+</span> {T.more}</summary>
            <div class="mt-3 grid gap-x-10 gap-y-4 md:grid-cols-2">
              <p><span class="label">{T.fromSan}</span>{fmt(T.fromSanVal, { mi: mi(sanFromHotel(h.id).miles, lang), t: dur(sanFromHotel(h.id).minutes, lang) })}</p>
              <p><span class="label">{T.rooms}</span>{h.roomTypes}</p>
              <p><span class="label">{T.kitchen}</span>{h.kitchen}</p>
              <p><span class="label">{T.goodFor}</span>{h.family}</p>
              <p><span class="label">{T.parking}</span>{h.parking}</p>
              <p class="md:col-span-2"><span class="label">{T.amenities}</span>{h.amenities.join(' · ')}. {T.amenitiesNote}</p>
              <p class="md:col-span-2"><a class="link tap" href={h.appleDirections} target="_blank" rel="noopener noreferrer">{T.appleDirections} ↗<span class="sr-only"> {t.newTab}</span></a></p>
            </div>
          </details>
        </li>
      ))}
    </ol>
    <p class="mt-5 max-w-2xl text-taupe">{fmt(T.foot, { source: T.routeSource, date: routeDate })} <button type="button" class="link tap" data-open-tools>{T.seeMap}</button></p>
  </section>

  <!-- 2. Airports and getting around -->
  <section id="airports" class="wrap mt-16 md:mt-24" aria-labelledby="air-h">
    <h2 id="air-h" class="h2">{T.airportsH}</h2>
    <div class="mt-8 grid gap-10 border-t border-charcoal/25 pt-8 md:grid-cols-2 md:gap-16">
      <div id="airport-info">
        <h3 class="h3">{T.flyingIn}</h3>
        <p class="mt-3" set:html={fmt(T.sanText, { b: `<strong class="font-semibold">${T.airportNames.SAN} (SAN)</strong>`, d: mi(ato.SAN.miles, lang), t: dur(ato.SAN.minutes, lang) })} />
        <p class="mt-3" set:html={fmt(T.crqText, { b: `<strong class="font-semibold">${T.airportNames.CRQ.replace(' (Carlsbad)', '')} (CRQ)</strong>`, d: mi(ato.CRQ.miles, lang) })} />
        <details class="disclose mt-3">
          <summary class="tap inline-flex items-center gap-2 font-semibold"><span class="plus text-2xl leading-none text-clay" aria-hidden="true">+</span> {T.otherAirports}</summary>
          <p class="mt-2 text-taupe">{fmt(T.otherBody, { ont: mi(ato.ONT.miles, lang), sna: mi(ato.SNA.miles, lang), lax: mi(ato.LAX.miles, lang) })}</p>
          <p class="mt-2 flex flex-wrap gap-x-5" set:html={[ext(links.ontario, T.ontario), ext(links.orangeCounty, T.orangeCounty), ext(links.lax, T.lax), ext(links.palomar, T.palomarInfo)].join('')} />
        </details>
      </div>
      <div id="cars">
        <h3 class="h3">{T.carsH}</h3>
        <p class="mt-3">{T.rentalFact1} {T.rentalFact2}</p>
        <p class="mt-3" set:html={fmt(T.rideshare, { uber: `<a class="link" href="${links.uber}" target="_blank" rel="noopener noreferrer">Uber${NT}</a>`, lyft: `<a class="link" href="${links.lyft}" target="_blank" rel="noopener noreferrer">Lyft${NT}</a>` })} />
        <details class="disclose mt-3">
          <summary class="tap inline-flex items-center gap-2 font-semibold"><span class="plus text-2xl leading-none text-clay" aria-hidden="true">+</span> {T.carCompanies}</summary>
          <p class="mt-3 flex flex-wrap gap-x-5" set:html={data.rentalCompanies.map((c) => ext(c.href, c.name)).join('')} />
          <p class="mt-2 text-taupe">{T.companiesNote}</p>
          <p class="mt-4">{T.sprinter} <a class="link tap" href={links.sprinter} target="_blank" rel="noopener noreferrer">NCTD SPRINTER ↗<span class="sr-only"> {t.newTab}</span></a></p>
        </details>
      </div>
    </div>
    <ul class="mt-10 grid gap-x-12 gap-y-3 border-t border-charcoal/25 pt-6 text-taupe md:grid-cols-2">
      {T.guidance.map((g) => <li><strong class="font-semibold text-charcoal">{g.t}.</strong> {g.b}</li>)}
    </ul>
  </section>

  <!-- 3. Airbnb / Vrbo -->
  <section id="stay-rentals" class="wrap mt-16 md:mt-24" aria-labelledby="rent-h">
    <h2 id="rent-h" class="h2">{T.rentalsH}</h2>
    <p class="mt-3 max-w-xl text-taupe">{T.rentalsNote}</p>
    <ul class="mt-6 border-t border-charcoal/25">
      {data.rentals.map((r) => (
        <li class="flex flex-wrap items-center justify-between gap-x-8 gap-y-1 border-b border-charcoal/25 py-4">
          <p><span class="h3">{r.area}</span><span class="ml-3 text-taupe">{r.note}</span></p>
          <p class="flex gap-5"><a class="tap link" href={r.airbnb} target="_blank" rel="noopener noreferrer">Airbnb ↗<span class="sr-only"> {t.newTab}</span></a><a class="tap link" href={r.vrbo} target="_blank" rel="noopener noreferrer">Vrbo ↗<span class="sr-only"> {t.newTab}</span></a></p>
        </li>
      ))}
    </ul>
  </section>

  <!-- 4. Shuttle + travel together -->
  <section id="together" class="wrap mt-16 md:mt-24">
    <div class="grid gap-10 border-t border-charcoal/25 pt-8 md:grid-cols-2 md:gap-16">
      <div id="shuttle">
        <h2 class="h3">{T.shuttleH}</h2>
        <div class="mt-3">{shuttle.arranged && shuttle.details ? <p>{tx(shuttle.details, lang)}</p> : <ComingSoon>{T.shuttleTbc}</ComingSoon>}</div>
      </div>
      <GuestConnect />
    </div>
  </section>

  <!-- 5. Optional tools (collapsed) -->
  <section id="trip-tools" class="wrap mt-16 md:mt-24" aria-labelledby="tools-h">
    <details class="disclose border border-charcoal/30 bg-paper" data-tools>
      <summary class="flex min-h-[4.5rem] items-center justify-between gap-6 px-5 py-4 md:px-8">
        <span><span id="tools-h" class="heading block text-[clamp(1.25rem,3vw,1.6rem)]">{T.toolsH}</span><span class="mt-1 block text-taupe">{T.toolsSub}</span></span>
        <span class="plus text-3xl text-clay" aria-hidden="true">+</span>
      </summary>
      <div class="border-t border-charcoal/20 px-5 py-8 md:px-8 md:py-12">
        <noscript><p class="mb-4 border border-charcoal/25 p-4">{T.toolsNoscript}</p></noscript>
        <TripConcierge client:visible data={data} />
      </div>
    </details>
  </section>
</Base>

<script>
  // Open the optional tools from links ("See them on a map") or a #trip-tools URL, or when they were open before a language switch.
  const tools = document.querySelector<HTMLDetailsElement>('[data-tools]');
  const openTools = () => { if (tools) { tools.open = true; tools.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' }); } };
  document.querySelectorAll('[data-open-tools]').forEach((b) => b.addEventListener('click', openTools));
  if (location.hash === '#trip-tools' || location.hash === '#concierge') { if (tools) tools.open = true; }
  try { if (sessionStorage.getItem('ae-switch-tools') && tools) { tools.open = true; } sessionStorage.removeItem('ae-switch-tools'); } catch {}
</script>

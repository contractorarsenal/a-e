---
import Base from '../../layouts/Base.astro';
import { useLang } from '../../i18n';
import { buildFaq } from '../../lib/faq';

export const getStaticPaths = () => [{ params: { lang: 'en' } }, { params: { lang: 'es' } }];
const { lang, t } = useLang(Astro);
const faq = buildFaq(lang);
---
<Base title={t.nav.faq} description={t.meta.faqDesc}>
  <div class="wrap pb-6 pt-10 md:pt-16">
    <h1 class="display text-[clamp(2.6rem,8vw,5rem)]">{t.nav.faq}</h1>
    <p class="mt-4 max-w-xl text-taupe">{t.faq.intro}</p>
    <div class="mt-10 max-w-3xl divide-y divide-charcoal/20 border-y border-charcoal/20">
      {faq.map((f) => (
        <details class="disclose" id={`q-${f.id}`}>
          <summary class="flex min-h-[3.75rem] items-center justify-between gap-6 py-3">
            <span class="heading text-[1.25rem] md:text-[1.375rem]">{f.q}</span>
            <span class="plus text-3xl text-clay" aria-hidden="true">+</span>
          </summary>
          <div class="pb-6 pr-8">
            {f.a ? <p class="prose-soft">{f.a}</p> : <p class="italic text-taupe">{t.toBeConfirmed}</p>}
            {f.link && <p class="mt-2"><a class="link tap" href={f.link.href}>{f.link.label} →</a></p>}
          </div>
        </details>
      ))}
    </div>
  </div>
</Base>

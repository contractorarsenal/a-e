---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Plate from '../../components/Plate.astro';
import Lightbox from '../../components/Lightbox.astro';
import { story as storyData, couple, wedding } from '../../content/site';
import { useLang, fmt, tx, dateShort } from '../../i18n';

export const getStaticPaths = () => [{ params: { lang: 'en' } }, { params: { lang: 'es' } }];
const { lang, t, l } = useLang(Astro);
const s = t.story;
---
<Base title={t.nav.story} description={fmt(t.meta.storyDesc, { couple: couple.display })}>
  <!-- Opening -->
  <PageHead title={t.nav.story} intro={s.lead} />

  <!-- 01 · Where it all began: older photographs, shown as they are -->
  <section id="began" class="wrap band band-cream py-14 md:py-20" aria-labelledby="ch1">
    <div>
      <h2 id="ch1" class="h2">{s.ch1}</h2>
      {storyData.earlyYears.approved && <p class="prose-soft mt-4">{tx(storyData.earlyYears.text, lang)}</p>}
      <p class="caption mt-2">{s.ch1Note}</p>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-x-10 gap-y-12 md:mt-14 md:grid-cols-2 md:items-center md:gap-y-16">
      <Plate slug="early-aprons" mat maxWidth="24rem" sizes="(min-width:768px) 24rem, 88vw" />
      <Plate slug="early-cart" mat maxWidth="17.5rem" sizes="(min-width:768px) 17.5rem, 70vw" delay={140} />
      <Plate slug="early-couch" mat maxWidth="30rem" sizes="(min-width:768px) 30rem, 94vw" class="md:col-span-2" />
    </div>
  </section>

  <!-- 02 · Through it all: the words, with two more photographs -->
  <section id="through" class="wrap band band-ivory py-14 md:py-20" aria-labelledby="ch2">
    <div>
      <div class="grid grid-cols-1 gap-10 md:grid-cols-2 md:gap-x-14">
        <div class="md:pt-6">
          <h2 id="ch2" class="h2">{s.heading}</h2>
          <div class="mt-6 space-y-5">
            {s.body.map((p) => <p class="text-[1.1875rem] leading-[1.75] md:text-[1.25rem]">{p}</p>)}
          </div>
          {storyData.chapters.length > 0 && (
            <div class="mt-10 space-y-8">
              {storyData.chapters.map((c) => <div><h3 class="heading text-xl">{tx(c.title, lang)}</h3><p class="prose-soft mt-2">{tx(c.body, lang)}</p></div>)}
            </div>
          )}
        </div>
        <div class="grid grid-cols-1 gap-10 md:gap-14">
          <Plate slug="early-luggage" mat maxWidth="26rem" sizes="(min-width:768px) 26rem, 90vw" />
          <Plate slug="early-airport" mat maxWidth="22rem" sizes="(min-width:768px) 22rem, 80vw" delay={140} />
        </div>
      </div>
    </div>
  </section>

  <!-- 03 · And then came forever: the proposal -->
  <section id="forever" class="wrap band band-sand py-14 md:py-20" aria-labelledby="ch3">
    <div>
      <h2 id="ch3" class="h2">{s.ch3}</h2>
      <p class="caption mt-2">{s.ch3Note}</p>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-x-8 gap-y-12 md:mt-14 md:grid-cols-2 md:gap-y-16">
      <Plate slug="proposal-moment" maxWidth="28rem" sizes="(min-width:768px) 28rem, 94vw" />
      <Plate slug="proposal-laughing" maxWidth="28rem" sizes="(min-width:768px) 28rem, 94vw" class="md:mt-24" delay={140} />
      <Plate slug="proposal-hands" maxWidth="28rem" sizes="(min-width:768px) 28rem, 94vw" />
      <Plate slug="proposal-kiss" maxWidth="28rem" sizes="(min-width:768px) 28rem, 94vw" class="md:mt-24" delay={140} />
    </div>

    <!-- The date -->
    <div class="mt-24 border-t border-charcoal/25 pt-12 text-center md:mt-32">
      <p class="h2">{dateShort(wedding.dateISO, lang)}</p>
      <p class="mt-6"><a class="link tap" href={l('/details')}>{s.weddingLink}</a></p>
    </div>
    <p class="mt-12 text-center text-taupe">{s.tap}</p>
  </section>
  <Lightbox />
</Base>

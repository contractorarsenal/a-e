---
import Base from '../../layouts/Base.astro';
import Plate from '../../components/Plate.astro';
import Lightbox from '../../components/Lightbox.astro';
import { story as storyData, couple, wedding } from '../../content/site';
import { useLang, fmt, tx, dateShort } from '../../i18n';

export const getStaticPaths = () => [{ params: { lang: 'en' } }, { params: { lang: 'es' } }];
const { lang, t, l } = useLang(Astro);
const s = t.story;
---
<Base title={t.nav.story} description={fmt(t.meta.storyDesc, { couple: couple.display })}>
  <!-- Opening -->
  <header class="wrap pb-2 pt-10 md:pt-16">
    <h1 class="display text-[clamp(2.6rem,8vw,5rem)]">{t.nav.story}</h1>
    <p class="display mt-6 text-[clamp(1.6rem,4vw,2.6rem)] italic text-clay">{s.lead}</p>
  </header>

  <!-- 01 · Where it all began: older photographs, shown as they are -->
  <section id="began" class="wrap mt-12 md:mt-20" aria-labelledby="ch1">
    <div class="border-t border-charcoal/25 pt-6">
      <h2 id="ch1" class="display text-[clamp(1.9rem,4.5vw,3rem)]"><span class="numeral mr-3 text-clay" aria-hidden="true">01</span>{s.ch1}</h2>
      {storyData.earlyYears.approved && <p class="prose-soft mt-4">{tx(storyData.earlyYears.text, lang)}</p>}
      <p class="caption mt-2">{s.ch1Note}</p>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-y-12 md:mt-14 md:grid-cols-12 md:gap-x-0 md:gap-y-16">
      <Plate slug="early-aprons" mat maxWidth="26rem" sizes="(min-width:768px) 26rem, 85vw" class="md:col-span-6 md:col-start-1" />
      <Plate slug="early-cart" mat maxWidth="17rem" sizes="(min-width:768px) 17rem, 62vw" class="ml-auto md:col-span-4 md:col-start-9 md:mt-24" />
      <Plate slug="early-couch" mat maxWidth="32rem" sizes="(min-width:768px) 32rem, 94vw" class="md:col-span-7 md:col-start-3" />
    </div>
  </section>

  <!-- 02 · Through it all: the words, with two more photographs -->
  <section id="through" class="wrap mt-20 md:mt-32" aria-labelledby="ch2">
    <div class="border-t border-charcoal/25 pt-6">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-2 md:gap-x-14">
        <div class="md:pt-6">
          <h2 id="ch2" class="display text-[clamp(1.9rem,4.5vw,3rem)]"><span class="numeral mr-3 text-clay" aria-hidden="true">02</span>{s.heading}</h2>
          <div class="mt-6 space-y-5">
            {s.body.map((p) => <p class="text-[1.1875rem] leading-[1.75] md:text-[1.25rem]">{p}</p>)}
          </div>
          {storyData.chapters.length > 0 && (
            <div class="mt-10 space-y-8">
              {storyData.chapters.map((c) => <div><h3 class="heading text-xl">{tx(c.title, lang)}</h3><p class="prose-soft mt-2">{tx(c.body, lang)}</p></div>)}
            </div>
          )}
        </div>
        <div class="grid grid-cols-1 gap-10 md:gap-14">
          <Plate slug="early-luggage" mat maxWidth="27rem" sizes="(min-width:768px) 27rem, 90vw" />
          <Plate slug="early-airport" mat maxWidth="20rem" sizes="(min-width:768px) 20rem, 72vw" class="ml-auto md:ml-12" />
        </div>
      </div>
    </div>
  </section>

  <!-- 03 · And then came forever: the proposal -->
  <section id="forever" class="wrap mt-20 md:mt-32" aria-labelledby="ch3">
    <div class="border-t border-charcoal/25 pt-6">
      <h2 id="ch3" class="display text-[clamp(1.9rem,4.5vw,3rem)]"><span class="numeral mr-3 text-clay" aria-hidden="true">03</span>{s.ch3}</h2>
      <p class="caption mt-2">{s.ch3Note}</p>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-x-8 gap-y-12 md:mt-14 md:grid-cols-2 md:gap-y-16">
      <Plate slug="proposal-moment" maxWidth="30rem" sizes="(min-width:768px) 30rem, 94vw" class="md:ml-auto" />
      <Plate slug="proposal-laughing" maxWidth="30rem" sizes="(min-width:768px) 30rem, 94vw" class="md:mt-24" />
      <Plate slug="proposal-hands" maxWidth="30rem" sizes="(min-width:768px) 30rem, 94vw" class="md:ml-auto" />
      <Plate slug="proposal-kiss" maxWidth="30rem" sizes="(min-width:768px) 30rem, 94vw" class="md:mt-24" />
    </div>

    <!-- The date -->
    <div class="mt-24 border-t border-charcoal/25 pt-12 text-center md:mt-32">
      <p class="display text-[clamp(2.4rem,7vw,4.5rem)]">{dateShort(wedding.dateISO, lang)}</p>
      <p class="mt-6"><a class="link tap" href={l('/details')}>{s.weddingLink}</a></p>
    </div>
  </section>

  <p class="wrap mt-10 text-center text-taupe">{s.tap}</p>
  <div class="h-8" aria-hidden="true"></div>
  <Lightbox />
</Base>

---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import RsvpForm from '../../components/RsvpForm.astro';
import { rsvpEndpoint, groupUrl } from '../../lib/env';
import { rsvp, couple, contact } from '../../content/site';
import { useLang, fmt, dateShort } from '../../i18n';

export const getStaticPaths = () => [{ params: { lang: 'en' } }, { params: { lang: 'es' } }];
const { lang, t } = useLang(Astro);
const endpoint = rsvpEndpoint();
---
<Base title={t.nav.rsvp} description={fmt(t.meta.rsvpDesc, { couple: couple.display })}>
  <PageHead title={t.nav.rsvp} />
  <div class="wrap band band-cream max-w-2xl py-12 md:py-16">
    {endpoint && rsvp.deadlineISO && <p class="mt-4 text-taupe">{fmt(t.rsvp.replyBy, { date: dateShort(rsvp.deadlineISO, lang) })}</p>}
    <div class="mt-10">
      {endpoint ? <RsvpForm endpoint={endpoint} groupUrl={groupUrl() ?? ''} deadlineISO={rsvp.deadlineISO ?? ''} maxAdditional={rsvp.maxAdditionalGuests} /> : (
        <div class="border-y border-charcoal/25 py-10">
          <p class="h2">{t.rsvp.closedTitle}</p>
          <p class="mt-3 max-w-md text-taupe">{t.rsvp.closedBody}</p>
        </div>
      )}
      {contact.approved && contact.email && <p class="mt-8 text-taupe">{t.footer.questions} <a class="link" href={`mailto:${contact.email}`}>{contact.email}</a></p>}
    </div>
  </div>
</Base>

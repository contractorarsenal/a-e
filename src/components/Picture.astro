---
import { u } from '../lib/url';
import manifest from '../generated/images.json';
interface Props {
  slug: keyof typeof manifest;
  alt: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
  imgClass?: string;
  position?: string; // object-position, e.g. "50% 40%"
  fit?: 'cover' | 'contain';
}
const { slug, alt, sizes = '100vw', loading = 'lazy', class: cls = '', imgClass = '', position = '50% 50%', fit = 'cover' } = Astro.props;
const m = manifest[slug];
const set = (ext: string) => m.widths.map((w: number) => `${u('/img/' + slug + '-' + w + '.' + ext)} ${w}w`).join(', ');
const fallbackW = m.widths.includes(1080) ? 1080 : m.widths[m.widths.length - 1];
---
<picture class={cls} style={`background-color:${m.color}`}>
  <source type="image/avif" srcset={set('avif')} sizes={sizes} />
  <source type="image/webp" srcset={set('webp')} sizes={sizes} />
  <img
    src={u(`/img/${slug}-${fallbackW}.jpg`)}
    sizes={sizes}
    width={m.width}
    height={m.height}
    alt={alt}
    loading={loading}
    decoding="async"
    fetchpriority={loading === 'eager' ? 'high' : 'auto'}
    class={`block h-full w-full ${fit === 'cover' ? 'object-cover' : 'object-contain'} ${imgClass}`}
    style={`object-position:${position}`}
  />
</picture>

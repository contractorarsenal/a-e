---
import { googleCalendarUrl, isTimed } from '../lib/calendar';
import { useLang } from '../i18n';
const { lang, t, l } = useLang(Astro);
const g = googleCalendarUrl(new URL(l('/'), Astro.site).href, lang);
---
<div>
  <div class="flex flex-wrap gap-3">
    <a class="btn btn-solid" href={l('/calendar.ics')} download>{t.calendar.ics}</a>
    <a class="btn" href={g} target="_blank" rel="noopener noreferrer">{t.calendar.google} ↗<span class="sr-only"> {t.newTab}</span></a>
  </div>
  <p class="mt-3 max-w-md text-taupe">{isTimed() ? t.calendar.noteTimed : t.calendar.noteDate}</p>
</div>

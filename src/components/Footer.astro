---
import { wedding, venue, allPages, contact } from '../content/site';
import { u } from '../lib/url';
import Monogram from './Monogram.astro';
---
<footer class="mt-8 border-t border-charcoal/15">
  <div class="wrap flex flex-col items-center gap-8 py-12 text-center md:flex-row md:justify-between md:text-left">
    <div>
      <Monogram class="text-[2.2rem]" />
      <p class="mt-3 text-taupe">Adrian &amp; Emma · {wedding.dateShort}<br />{venue.name}, {wedding.cityLine}</p>
    </div>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap justify-center gap-x-6 text-[.8rem] uppercase tracking-[.14em]">
        {[...allPages, { href: '/rsvp', label: 'RSVP' }].map((n) => <li><a href={u(n.href)} class="tap">{n.label}</a></li>)}
      </ul>
    </nav>
  </div>
  {contact.email && <p class="wrap pb-10 text-center text-sm text-taupe">Questions? <a class="link" href={`mailto:${contact.email}`}>{contact.email}</a></p>}
</footer>

---
import { wedding, venue, nav, contact } from '../content/site';
import { u } from '../lib/url';
import Monogram from './Monogram.astro';
---
<footer class="on-ink">
  <div class="wrap py-20 md:py-28">
    <div class="text-center">
      <Monogram class="text-[4.5rem] text-sand md:text-[6rem]" />
      <p class="display mt-8 text-[clamp(2rem,5vw,3.4rem)]">Adrian <span class="italic-display text-sand">&amp;</span> Emma</p>
      <p class="eyebrow mt-5">{wedding.dateLong}</p>
      <p class="mt-2 text-ivory/70">{venue.name} · {wedding.cityLine}</p>
    </div>
    <nav aria-label="Footer" class="mt-14 flex flex-wrap justify-center gap-x-8 gap-y-1">
      {[...nav, { href: '/rsvp', label: 'RSVP' }].map((n) => <a href={u(n.href)} class="tap text-[.72rem] uppercase tracking-[.26em] text-ivory/80 hover:text-ivory">{n.label}</a>)}
    </nav>
    <p class="mt-10 text-center text-sm text-ivory/60">
      {contact.email ? <>Questions? <a class="link" href={`mailto:${contact.email}`}>{contact.email}</a></> : 'A contact for guest questions is coming soon.'}
      <span aria-hidden="true"> · </span><a class="link" href={venue.website} rel="noopener" target="_blank">Venue website ↗</a>
    </p>
  </div>
</footer>

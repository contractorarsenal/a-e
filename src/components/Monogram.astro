---
const { class: cls = '' } = Astro.props as { class?: string };
---
<span class={`inline-flex items-baseline gap-[.28em] font-display leading-none ${cls}`} aria-hidden="true">
  <span>A</span>
  <span class="relative -top-[.12em] text-[.5em] font-normal italic opacity-70">+</span>
  <span>E</span>
</span>

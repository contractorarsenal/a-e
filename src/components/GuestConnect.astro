---
import { u } from '../lib/url';
import { groupUrl, groupGate } from '../lib/env';
import ComingSoon from './ComingSoon.astro';
const url = groupUrl();
const gate = groupGate();
---
<div>
  <h2 class="display text-2xl">Travel together</h2>
  <p class="mt-3">Traveling to celebrate with us? Connect with other guests to coordinate stays, rides, and plans.</p>
  <p class="mt-2 text-sm text-taupe">Optional. Nobody is added automatically, and no one’s contact details are shown on this site.</p>
  <div class="mt-4">
    {url && gate === 'public' && <a class="btn" href={url} target="_blank" rel="noopener noreferrer">Join the guest group ↗</a>}
    {url && gate === 'rsvp' && <p>The group link appears after you <a class="link" href={u('/rsvp')}>RSVP</a> as attending.</p>}
    {!url && <ComingSoon>Group link coming soon</ComingSoon>}
  </div>
</div>

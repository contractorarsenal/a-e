---
import { groupUrl, groupGate } from '../lib/env';
import { useLang, fmt } from '../i18n';
import ComingSoon from './ComingSoon.astro';
const { t, l } = useLang(Astro);
const url = groupUrl();
const gate = groupGate();
const link = `<a class="link" href="${l('/rsvp')}">${t.nav.rsvpVerb}</a>`;
---
<div id="together-group">
  <h2 class="h2">{t.travel.togetherH}</h2>
  <p class="mt-3">{t.travel.togetherBody}</p>
  <p class="mt-2 text-taupe">{t.travel.togetherNote}</p>
  <div class="mt-4">
    {url && gate === 'public' && <a class="btn" href={url} target="_blank" rel="noopener noreferrer">{t.travel.groupJoin} ↗<span class="sr-only"> {t.newTab}</span></a>}
    {url && gate === 'rsvp' && <p set:html={fmt(t.travel.groupAfterRsvp, { link })} />}
    {!url && <ComingSoon>{t.travel.groupSoon}</ComingSoon>}
  </div>
</div>

---
import { schedule } from '../content/site';
import ComingSoon from './ComingSoon.astro';
---
{schedule.length ? (
  <ol class="relative border-l border-charcoal/25 pl-8 md:pl-12">
    {schedule.map((s) => (
      <li class="relative pb-12 last:pb-0">
        <span class="absolute -left-[2.43rem] top-3 h-[.6rem] w-[.6rem] rounded-full bg-clay md:-left-[3.43rem]" aria-hidden="true"></span>
        <p class="display text-3xl md:text-4xl">{s.time}</p>
        <p class="mt-1 text-lg">{s.title}</p>{s.note && <p class="text-taupe">{s.note}</p>}
      </li>
    ))}
  </ol>
) : (
  <div class="border-l border-charcoal/25 pl-8 md:pl-12">
    <ComingSoon>Details coming soon</ComingSoon>
    <p class="mt-3 max-w-md text-taupe">The ceremony and reception schedule will appear here as soon as it is confirmed.</p>
  </div>
)}

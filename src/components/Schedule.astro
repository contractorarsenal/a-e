---
import { schedule } from '../content/site';
import ComingSoon from './ComingSoon.astro';
---
{schedule.length ? (
  <ol class="divide-y divide-charcoal/12 border-y border-charcoal/12">
    {schedule.map((s) => (
      <li class="grid gap-1 py-6 md:grid-cols-[10rem_1fr] md:gap-8">
        <p class="display text-3xl">{s.time}</p>
        <div><p class="text-lg">{s.title}</p>{s.note && <p class="text-taupe">{s.note}</p>}</div>
      </li>
    ))}
  </ol>
) : (
  <div class="border-y border-charcoal/12 py-10">
    <ComingSoon>Details coming soon</ComingSoon>
    <p class="mt-3 max-w-md text-taupe">The ceremony and reception schedule will appear here as soon as it is confirmed.</p>
  </div>
)}

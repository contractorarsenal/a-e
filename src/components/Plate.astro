---
/** One uncropped photograph at its natural proportions, opening in the lightbox. Never crops faces: the frame matches the file. */
import { u } from '../lib/url';
import Picture from './Picture.astro';
import manifest from '../generated/images.json';
import type { PhotoSlug } from '../lib/photos';
import { useLang, fmt } from '../i18n';
interface Props { slug: PhotoSlug; sizes: string; class?: string; maxWidth?: string; mat?: boolean; loading?: 'lazy' | 'eager' }
const { slug, sizes, class: cls = '', maxWidth = '100%', mat = false, loading = 'lazy' } = Astro.props;
const { t } = useLang(Astro);
const m = manifest[slug];
const p = t.photos[slug];
const srcset = (m.widths as number[]).map((w) => `${u('/img/' + slug + '-' + w + '.webp')} ${w}w`).join(', ');
---
<figure class={`reveal ${cls}`} style={`max-width:${maxWidth}`}>
  <button type="button" data-lb data-srcset={srcset} data-alt={p.alt} data-caption={p.caption} aria-label={fmt(t.story.photoOpen, { caption: p.caption })} class="group block w-full cursor-zoom-in text-left">
    <span class={`block ${mat ? 'bg-paper p-2 ring-1 ring-charcoal/15 md:p-3' : ''}`}>
      <span class="block overflow-hidden bg-champagne" style={`aspect-ratio:${m.width}/${m.height}`}>
        <Picture slug={slug} alt="" sizes={sizes} loading={loading} />
      </span>
    </span>
  </button>
  <figcaption class="caption mt-3">{p.caption}</figcaption>
</figure>

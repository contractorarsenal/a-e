---
import { u } from '../lib/url';
import { nav } from '../content/site';
import Monogram from './Monogram.astro';
const baseP = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.slice(baseP.length).replace(/\/$/, '') || '/';
---
<header id="site-header" class="fixed inset-x-0 top-0 z-40 border-b border-transparent bg-ivory/90 backdrop-blur-md transition-colors duration-500">
  <div class="wrap flex h-[4.25rem] items-center justify-between">
    <a href={u("/")} class="text-[1.7rem] text-charcoal no-underline" aria-label="A + E — home"><Monogram /></a>
    <nav aria-label="Primary" class="hidden items-center gap-9 md:flex">
      {nav.map((n) => (
        <a href={u(n.href)} aria-current={path === n.href ? 'page' : undefined} class="inline-flex min-h-11 items-center text-[.72rem] font-medium uppercase tracking-[.26em] text-charcoal/80 transition-colors hover:text-charcoal aria-[current=page]:text-charcoal aria-[current=page]:underline aria-[current=page]:decoration-sand aria-[current=page]:underline-offset-[.6em]">{n.label}</a>
      ))}
      <a href={u("/rsvp")} class="btn !min-h-[2.5rem] !px-5 !text-[.7rem]">RSVP</a>
    </nav>
    <button id="menu-btn" type="button" class="-mr-2 grid h-12 w-12 place-items-center md:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
      <span class="relative block h-3 w-7" aria-hidden="true">
        <span class="bar absolute left-0 top-0 h-px w-full bg-charcoal transition-transform duration-300"></span>
        <span class="bar absolute bottom-0 left-0 h-px w-full bg-charcoal transition-transform duration-300"></span>
      </span>
    </button>
  </div>
</header>

<div id="mobile-menu" hidden class="fixed inset-0 z-30 flex flex-col bg-ivory pt-[4.25rem] md:hidden" role="dialog" aria-modal="true" aria-label="Menu">
  <nav aria-label="Mobile" class="flex flex-1 flex-col justify-center gap-1 px-8 pb-16">
    {[...nav, { href: '/rsvp', label: 'RSVP' }].map((n, i) => (
      <a href={u(n.href)} style={`--d:${i * 60}ms`} aria-current={path === n.href ? 'page' : undefined} class="menu-link display border-b border-charcoal/10 py-4 text-[2.4rem] text-charcoal no-underline aria-[current=page]:italic">{n.label}</a>
    ))}
    <p class="eyebrow mt-10">Saturday · August 28 · 2027<br />Escondido, California</p>
  </nav>
</div>

<style>
  #mobile-menu:not([hidden]) .menu-link { animation: rise .7s var(--ease-soft) both; animation-delay: var(--d); }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  #menu-btn[aria-expanded='true'] .bar:first-child { transform: translateY(.34rem) rotate(45deg); }
  #menu-btn[aria-expanded='true'] .bar:last-child { transform: translateY(-.34rem) rotate(-45deg); }
  #site-header.scrolled { border-color: color-mix(in srgb, var(--color-charcoal) 12%, transparent); }
</style>

<script>
  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const header = document.getElementById('site-header')!;
  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) (menu.querySelector('a') as HTMLElement)?.focus();
  };
  btn.addEventListener('click', () => setOpen(!!menu.hidden));
  menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) { setOpen(false); btn.focus(); }
    if (e.key === 'Tab' && !menu.hidden) {
      const f = [btn, ...menu.querySelectorAll<HTMLElement>('a')];
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });
  matchMedia('(min-width: 768px)').addEventListener('change', (m) => m.matches && setOpen(false));
  const onScroll = () => header.classList.toggle('scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true }); onScroll();
</script>

---
import { nav, allPages, pageNames } from '../content/site';
import { u } from '../lib/url';
import Monogram from './Monogram.astro';
const baseP = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.slice(baseP.length).replace(/\/$/, '') || '/';
const here = pageNames[path];
---
<header id="site-header" class="fixed inset-x-0 top-0 z-40 border-b border-charcoal/10 bg-ivory/95 backdrop-blur">
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <div class="flex min-w-0 items-baseline gap-3">
      <a href={u('/')} class="shrink-0 text-[1.6rem] no-underline" aria-label="Adrian & Emma, home" aria-current={path === '/' ? 'page' : undefined}><Monogram /></a>
      {here && <span class="truncate text-sm text-taupe"><span aria-hidden="true" class="mr-2 text-sand">/</span>{here}</span>}
    </div>

    <nav aria-label="Primary" class="hidden items-center gap-8 md:flex">
      {nav.map((n) => (
        <a href={u(n.href)} aria-current={path === n.href ? 'page' : undefined} class="nav-link tap text-[.8rem] font-medium uppercase tracking-[.16em]">{n.label}</a>
      ))}
      <a href={u('/rsvp')} aria-current={path === '/rsvp' ? 'page' : undefined} class="btn btn-solid !min-h-10 !px-5 !text-[.74rem]">RSVP</a>
    </nav>

    <button id="menu-btn" type="button" class="tap -mr-2 px-2 text-[.8rem] font-medium uppercase tracking-[.16em] md:hidden" aria-expanded="false" aria-controls="mobile-menu">
      <span data-menu-label>Menu</span>
    </button>
  </div>
</header>

<div id="mobile-menu" hidden class="fixed inset-0 z-30 flex flex-col overflow-y-auto bg-ivory pt-16 md:hidden" role="dialog" aria-modal="true" aria-label="Site menu">
  <nav aria-label="Mobile" class="wrap flex flex-1 flex-col pb-8 pt-6">
    <ul class="border-t border-charcoal/15">
      {allPages.map((n) => (
        <li class="border-b border-charcoal/15">
          <a href={u(n.href)} aria-current={path === n.href ? 'page' : undefined} class="display flex min-h-16 items-center justify-between py-2 text-[1.9rem] no-underline aria-[current=page]:italic">
            {n.label}{path === n.href && <span class="text-sm not-italic text-clay" aria-hidden="true">you are here</span>}
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-auto pt-10">
      <a href={u('/rsvp')} aria-current={path === '/rsvp' ? 'page' : undefined} class="btn btn-solid w-full">RSVP</a>
      <p class="mt-6 text-center text-sm text-taupe">Saturday, August 28, 2027 · Escondido, California</p>
    </div>
  </nav>
</div>

<style>
  .nav-link { color: color-mix(in srgb, var(--color-charcoal) 75%, transparent); transition: color .2s; }
  .nav-link:hover, .nav-link[aria-current='page'] { color: var(--color-charcoal); }
  .nav-link[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--color-clay); text-underline-offset: .55em; text-decoration-thickness: 1px; }
</style>

<script>
  const btn = document.getElementById('menu-btn')!;
  const label = btn.querySelector<HTMLElement>('[data-menu-label]')!;
  const menu = document.getElementById('mobile-menu')!;
  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    label.textContent = open ? 'Close' : 'Menu';
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) (menu.querySelector('a') as HTMLElement)?.focus();
  };
  btn.addEventListener('click', () => setOpen(!!menu.hidden));
  menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) { setOpen(false); btn.focus(); }
    if (e.key === 'Tab' && !menu.hidden) {
      const f = [btn, ...menu.querySelectorAll<HTMLElement>('a')];
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });
  matchMedia('(min-width: 768px)').addEventListener('change', (m) => m.matches && setOpen(false));
</script>

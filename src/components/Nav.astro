---
import { useLang } from '../i18n';
import LangSwitch from './LangSwitch.astro';

const { t, l } = useLang(Astro);
const baseP = import.meta.env.BASE_URL.replace(/\/$/, '');
const rest = Astro.url.pathname.slice(baseP.length).split('/').slice(2).join('/').replace(/\/$/, '');
const path = rest ? '/' + rest : '/';
// Four main places, in the order a guest needs them. Story and FAQ sit under "More" (menu and footer).
const main = [
  { href: '/', label: t.nav.home },
  { href: '/details', label: t.nav.wedding },
  { href: '/travel', label: t.nav.travel },
];
const more = [
  { href: '/story', label: t.nav.story },
  { href: '/faq', label: t.nav.faq },
];
---
<header id="site-header" class="sticky top-0 z-40 border-b border-charcoal/25 bg-ivory">
  <div class="wrap flex min-h-16 flex-wrap items-center justify-between gap-x-3 gap-y-1 py-1">
    <a href={l('/')} class="tap min-w-0 font-display text-[1.3rem] font-semibold no-underline md:text-[1.5rem]" aria-label={t.nav.homeAria} aria-current={path === '/' ? 'page' : undefined}>Adrian &amp; Emma</a>

    <div class="flex flex-wrap items-center justify-end gap-x-2 gap-y-1 sm:gap-x-4">
      <nav aria-label={t.nav.primary} class="hidden items-center gap-6 lg:flex">
        {main.map((n) => (
          <a href={l(n.href)} aria-current={path === n.href ? 'page' : undefined} class="nav-link tap text-[1.125rem] font-semibold">{n.label}</a>
        ))}
        <a href={l('/rsvp')} aria-current={path === '/rsvp' ? 'page' : undefined} class="btn btn-solid !min-h-12 !px-5">{t.nav.rsvp}</a>
      </nav>
      <LangSwitch />
      <button id="menu-btn" type="button" class="menu-btn tap min-w-11 justify-center border-[1.5px] border-charcoal px-3 text-[1.0625rem] font-bold lg:hidden" aria-expanded="false" aria-controls="mobile-menu"
        data-open={t.nav.menu} data-close={t.nav.close}>
        <span data-menu-label>{t.nav.menu}</span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" hidden class="fixed inset-x-0 bottom-0 top-16 z-30 flex flex-col overflow-y-auto bg-ivory lg:hidden" role="dialog" aria-modal="true" aria-label={t.nav.menuLabel}>
  <nav aria-label={t.nav.mobile} class="wrap flex flex-1 flex-col pb-8 pt-3">
    <ul>
      {main.map((n) => (
        <li class="border-b border-charcoal/20">
          <a href={l(n.href)} aria-current={path === n.href ? 'page' : undefined} class="menu-link flex min-h-16 items-center py-2 pl-3 text-[1.5rem] font-semibold no-underline">{n.label}</a>
        </li>
      ))}
    </ul>
    <p class="mt-6"><a href={l('/rsvp')} aria-current={path === '/rsvp' ? 'page' : undefined} class="btn btn-solid w-full !min-h-16 text-[1.25rem]">{t.nav.rsvp}</a></p>
    <p class="mt-8 pl-3 font-semibold text-taupe">{t.nav.more}</p>
    <ul class="mt-1">
      {more.map((n) => (
        <li>
          <a href={l(n.href)} aria-current={path === n.href ? 'page' : undefined} class="menu-link flex min-h-14 items-center py-2 pl-3 text-[1.25rem] no-underline">{n.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<style>
  .nav-link { color: var(--color-charcoal); border-bottom: 3px solid transparent; }
  .nav-link:hover { border-bottom-color: color-mix(in srgb, var(--color-charcoal) 35%, transparent); }
  .nav-link[aria-current='page'] { border-bottom-color: var(--color-clay); }
  .menu-link { border-left: 4px solid transparent; }
  .menu-link[aria-current='page'] { border-left-color: var(--color-clay); font-weight: 700; }
  .menu-btn[aria-expanded='true'] { background: var(--color-charcoal); color: var(--color-ivory); }
</style>

<script>
  const btn = document.getElementById('menu-btn')!;
  const label = btn.querySelector<HTMLElement>('[data-menu-label]')!;
  const menu = document.getElementById('mobile-menu')!;
  const header = document.getElementById('site-header')!;
  // The header grows with text size, so everything that sits below it follows its real height.
  const syncHeight = () => { const h = header.offsetHeight; document.documentElement.style.setProperty('--hh', h + 'px'); menu.style.top = h + 'px'; };
  syncHeight();
  new ResizeObserver(syncHeight).observe(header);
  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    label.textContent = open ? btn.dataset.close! : btn.dataset.open!;
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open && viaKey) (menu.querySelector('a') as HTMLElement)?.focus();
  };
  let viaKey = false;
  btn.addEventListener('click', (e) => { viaKey = (e as MouseEvent).detail === 0; setOpen(!!menu.hidden); });
  menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) { setOpen(false); btn.focus(); }
    if (e.key === 'Tab' && !menu.hidden) {
      // keep keyboard focus inside the open menu (header controls + menu links)
      const f = [...document.querySelectorAll<HTMLElement>('#site-header a, #menu-btn, #mobile-menu a')].filter((el) => el.offsetParent !== null);
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });
  matchMedia('(min-width: 1024px)').addEventListener('change', (m) => m.matches && setOpen(false));
</script>

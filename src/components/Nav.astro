---
import { primaryNav, allPages } from '../content/site';
import { useLang } from '../i18n';
import Monogram from './Monogram.astro';
import LangSwitch from './LangSwitch.astro';

const { t, l } = useLang(Astro);
const baseP = import.meta.env.BASE_URL.replace(/\/$/, '');
const rest = Astro.url.pathname.slice(baseP.length).split('/').slice(2).join('/').replace(/\/$/, '');
const path = rest ? '/' + rest : '/';
const here = ({ '/details': t.nav.wedding, '/travel': t.nav.travel, '/rsvp': t.nav.rsvp, '/story': t.nav.story, '/faq': t.nav.faq } as Record<string, string>)[path];
---
<header id="site-header" class="fixed inset-x-0 top-0 z-40 border-b border-charcoal/15 bg-ivory">
  <div class="wrap flex h-16 items-center justify-between gap-3">
    <div class="flex min-w-0 items-baseline gap-3">
      <a href={l('/')} class="tap shrink-0 text-[1.6rem] no-underline" aria-label={t.nav.home} aria-current={path === '/' ? 'page' : undefined}><Monogram /></a>
      {here && <span class="hidden truncate text-taupe xl:inline"><span aria-hidden="true" class="mr-2">/</span>{here}</span>}
    </div>

    <div class="flex items-center gap-1 sm:gap-3">
      <nav aria-label={t.nav.primary} class="hidden items-center gap-7 lg:flex">
        {primaryNav.map((n) => (
          <a href={l(n.href)} aria-current={path === n.href ? 'page' : undefined} class="nav-link tap text-[1.0625rem] font-semibold">{t.nav[n.key]}</a>
        ))}
        <a href={l('/rsvp')} aria-current={path === '/rsvp' ? 'page' : undefined} class="btn btn-solid !min-h-11 !px-5">{t.nav.rsvp}</a>
      </nav>
      <LangSwitch class="lg:ml-2" />
      <button id="menu-btn" type="button" class="tap -mr-1 min-w-11 justify-center px-2 text-[1.0625rem] font-semibold lg:hidden" aria-expanded="false" aria-controls="mobile-menu"
        data-open={t.nav.menu} data-close={t.nav.close}>
        <span data-menu-label>{t.nav.menu}</span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" hidden class="fixed inset-0 z-30 flex flex-col overflow-y-auto bg-ivory pt-16 lg:hidden" role="dialog" aria-modal="true" aria-label={t.nav.menuLabel}>
  <nav aria-label={t.nav.mobile} class="wrap flex flex-1 flex-col pb-8 pt-4">
    <ul class="border-t border-charcoal/20">
      {allPages.map((n) => (
        <li class="border-b border-charcoal/20">
          <a href={l(n.href)} aria-current={path === n.href ? 'page' : undefined} class="display flex min-h-16 flex-wrap items-center justify-between gap-x-4 py-2 text-[1.75rem] no-underline aria-[current=page]:italic">
            <span>{t.nav[n.key]}</span>{path === n.href && <span class="font-sans text-base font-normal not-italic text-clay">{t.nav.here}</span>}
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-auto pt-10">
      <a href={l('/rsvp')} aria-current={path === '/rsvp' ? 'page' : undefined} class="btn btn-solid w-full">{t.nav.rsvp}</a>
    </div>
  </nav>
</div>

<style>
  .nav-link { color: color-mix(in srgb, var(--color-charcoal) 82%, transparent); transition: color .2s; }
  .nav-link:hover, .nav-link[aria-current='page'] { color: var(--color-charcoal); }
  .nav-link[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--color-clay); text-underline-offset: .4em; text-decoration-thickness: 2px; }
</style>

<script>
  const btn = document.getElementById('menu-btn')!;
  const label = btn.querySelector<HTMLElement>('[data-menu-label]')!;
  const menu = document.getElementById('mobile-menu')!;
  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    label.textContent = open ? btn.dataset.close! : btn.dataset.open!;
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) (menu.querySelector('a') as HTMLElement)?.focus();
  };
  btn.addEventListener('click', () => setOpen(!!menu.hidden));
  menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) { setOpen(false); btn.focus(); }
    if (e.key === 'Tab' && !menu.hidden) {
      // keep keyboard focus inside the open menu (header controls + menu links)
      const f = [...document.querySelectorAll<HTMLElement>('#site-header a, #menu-btn, #mobile-menu a')].filter((el) => el.offsetParent !== null);
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });
  matchMedia('(min-width: 1024px)').addEventListener('change', (m) => m.matches && setOpen(false));
</script>

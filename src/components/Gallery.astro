---
import { u } from '../lib/url';
import Picture from './Picture.astro';
import manifest from '../generated/images.json';
import { photos, type PhotoSlug } from '../lib/photos';

// Editorial layout: spans chosen so no photo is cropped through a face (all photos are 3:4 portraits).
const layout: { slug: PhotoSlug; cls: string; pos: string; arch?: boolean }[] = [
  { slug: 'proposal-moment', cls: 'md:col-span-5', pos: '50% 45%' },
  { slug: 'proposal-laughing', cls: 'md:col-span-4 md:mt-28', pos: '50% 45%', arch: true },
  { slug: 'proposal-kiss', cls: 'md:col-span-3 md:mt-10', pos: '50% 40%' },
  { slug: 'proposal-hands', cls: 'md:col-span-5 md:col-start-2 md:-mt-6', pos: '50% 50%' },
];
const full = (slug: PhotoSlug) => (manifest[slug].widths as number[]).map((w) => `${u('/img/' + slug + '-' + w + '.webp')} ${w}w`).join(', ');
---
<div class="grid grid-cols-2 gap-3 md:grid-cols-9 md:gap-6" data-gallery>
  {layout.map((p, i) => (
    <button type="button" data-index={i} data-srcset={full(p.slug)} data-alt={photos[p.slug].alt} data-caption={photos[p.slug].caption}
      aria-label={`Open photo ${i + 1} of ${layout.length}: ${photos[p.slug].caption}`}
      class={`reveal group relative block cursor-zoom-in overflow-hidden ${p.cls}`}>
      <div class={`aspect-[3/4] overflow-hidden ${p.arch ? 'rounded-t-full' : ''}`}>
        <Picture slug={p.slug} alt={photos[p.slug].alt} sizes="(min-width:768px) 40vw, 50vw" position={p.pos} imgClass="transition-transform duration-[1400ms] ease-[var(--ease-soft)] group-hover:scale-[1.03]" />
      </div>
      <span class="mt-3 block text-left italic-display text-lg text-taupe">{photos[p.slug].caption}</span>
    </button>
  ))}
</div>

<dialog id="lightbox" aria-label="Photo viewer" class="m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-charcoal/95">
  <div class="relative flex h-full w-full flex-col text-ivory" data-lb-stage>
    <div class="flex items-center justify-between px-4 py-3 md:px-8">
      <p class="eyebrow !text-ivory/70" data-lb-count aria-live="polite"></p>
      <button type="button" data-lb-close class="grid h-12 w-12 place-items-center text-3xl leading-none" aria-label="Close photo viewer">×</button>
    </div>
    <div class="relative min-h-0 flex-1 touch-pan-y select-none" data-lb-swipe>
      <img data-lb-img alt="" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" class="mx-auto h-full w-full object-contain px-2 md:px-20 transition-opacity duration-300" />
      <button type="button" data-lb-prev class="absolute left-1 top-1/2 hidden h-14 w-14 -translate-y-1/2 place-items-center text-4xl md:grid" aria-label="Previous photo">‹</button>
      <button type="button" data-lb-next class="absolute right-1 top-1/2 hidden h-14 w-14 -translate-y-1/2 place-items-center text-4xl md:grid" aria-label="Next photo">›</button>
    </div>
    <p data-lb-caption class="px-6 py-4 text-center font-display text-xl italic text-ivory/85"></p>
  </div>
</dialog>

<script>
  const grid = document.querySelector<HTMLElement>('[data-gallery]');
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  if (grid && dlg) {
    const items = [...grid.querySelectorAll<HTMLButtonElement>('button[data-index]')];
    const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const count = dlg.querySelector<HTMLElement>('[data-lb-count]')!;
    const cap = dlg.querySelector<HTMLElement>('[data-lb-caption]')!;
    const swipe = dlg.querySelector<HTMLElement>('[data-lb-swipe]')!;
    let i = 0, opener: HTMLElement | null = null;
    const show = (n: number) => {
      i = (n + items.length) % items.length;
      const b = items[i];
      img.style.opacity = '0';
      img.sizes = '100vw';
      img.srcset = b.dataset.srcset!;
      img.alt = b.dataset.alt!;
      cap.textContent = b.dataset.caption ?? '';
      count.textContent = `${i + 1} / ${items.length}`;
      requestAnimationFrame(() => (img.style.opacity = '1'));
      // preload neighbours
      [i + 1, i - 1].forEach((k) => { const nb = items[(k + items.length) % items.length]; const im = new Image(); im.sizes = '100vw'; im.srcset = nb.dataset.srcset!; });
    };
    const open = (n: number, from: HTMLElement) => { opener = from; show(n); dlg.showModal(); document.documentElement.style.overflow = 'hidden'; };
    const close = () => dlg.close();
    items.forEach((b, n) => b.addEventListener('click', () => open(n, b)));
    dlg.addEventListener('close', () => { document.documentElement.style.overflow = ''; opener?.focus(); });
    dlg.querySelector('[data-lb-close]')!.addEventListener('click', close);
    dlg.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(i - 1));
    dlg.querySelector('[data-lb-next]')!.addEventListener('click', () => show(i + 1));
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); show(i + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(i - 1); }
    });
    // click on empty backdrop area closes
    dlg.addEventListener('click', (e) => { if (e.target === dlg || (e.target as HTMLElement).dataset.lbStage !== undefined) close(); });
    // swipe
    let x0 = 0, y0 = 0, tracking = false;
    swipe.addEventListener('pointerdown', (e) => { x0 = e.clientX; y0 = e.clientY; tracking = true; });
    swipe.addEventListener('pointerup', (e) => {
      if (!tracking) return; tracking = false;
      const dx = e.clientX - x0, dy = e.clientY - y0;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.4) show(i + (dx < 0 ? 1 : -1));
    });
    swipe.addEventListener('pointercancel', () => (tracking = false));
  }
</script>

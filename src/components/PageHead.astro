---
import { useLang } from '../i18n';
const { t, l } = useLang(Astro);
const { title, intro } = Astro.props as { title: string; intro?: string };
---
<div class="wrap pb-8 pt-6 md:pb-10 md:pt-10">
  <a href={l('/')} class="tap link font-semibold no-underline hover:underline"><span aria-hidden="true">←&nbsp;</span>{t.nav.backHome}</a>
  <h1 class="page-title mt-3">{title}</h1>
  {intro && <p class="prose-soft mt-4 max-w-2xl">{intro}</p>}
</div>

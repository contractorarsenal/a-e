---
import { useLang } from '../i18n';
const { endpoint, groupUrl, deadlineISO, maxAdditional } = Astro.props as { endpoint: string; groupUrl: string; deadlineISO: string; maxAdditional: number };
const { lang, t, l } = useLang(Astro);
const r = t.rsvp;
const i18n = { lang, ...r, next: { travel: l('/travel'), details: l('/details'), home: l('/') }, newTab: t.newTab };
const opt = ` ${r.optional}`;
const choice = 'flex min-w-0 min-h-[3.5rem] cursor-pointer items-center gap-3 border-[1.5px] border-line bg-paper px-4 py-2 has-[:checked]:border-charcoal has-[:checked]:bg-champagne/50 has-[:focus-visible]:outline has-[:focus-visible]:outline-[3px] has-[:focus-visible]:outline-clay';
---
<div id="rsvp-app" data-endpoint={endpoint} data-group={groupUrl} data-deadline={deadlineISO} data-max={maxAdditional} data-i18n={JSON.stringify(i18n)}>
  <form data-form novalidate class="mx-auto max-w-xl">
    <div class="grid gap-6 sm:grid-cols-2">
      <label class="block"><span class="label">{r.first}</span><input class="field" name="firstName" required autocomplete="given-name" maxlength="60" /></label>
      <label class="block"><span class="label">{r.last}</span><input class="field" name="lastName" required autocomplete="family-name" maxlength="60" /></label>
    </div>
    <div class="mt-7 space-y-7">
      <label class="block"><span class="label">{r.email}</span><input class="field" type="email" name="email" required autocomplete="email" maxlength="200" inputmode="email" /></label>
      <label class="block"><span class="label">{r.phone}<span class="font-normal text-taupe">{opt}</span></span><input class="field" type="tel" name="phone" autocomplete="tel" maxlength="40" inputmode="tel" /></label>
    </div>

    <fieldset class="mt-10 min-w-0">
      <legend class="label">{r.attending}</legend>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <!-- The submitted values stay English whatever the page language, so the couple's inbox is consistent. -->
        <label class={choice}><input class="check" type="radio" name="attending" value="Joyfully accepts" required /> {r.yes}</label>
        <label class={choice}><input class="check" type="radio" name="attending" value="Regretfully declines" /> {r.no}</label>
      </div>
    </fieldset>

    <div data-attending-only hidden class="mt-10 space-y-7">
      <fieldset class="min-w-0">
        <legend class="label">{r.extraLegend}<span class="font-normal text-taupe">{opt}</span></legend>
        <p class="mt-2 text-taupe">{r.extraHelp.replace('{max}', String(maxAdditional))}</p>
        <div class="mt-3 space-y-4" data-guests></div>
        <button type="button" class="btn mt-4" data-add-guest>{r.addGuest}</button>
      </fieldset>
      <label class="block"><span class="label">{r.dietary}<span class="font-normal text-taupe">{opt}</span></span><textarea class="field" name="dietary" maxlength="500" placeholder={r.dietaryPh}></textarea></label>
      <label class="block"><span class="label">{r.access}<span class="font-normal text-taupe">{opt}</span></span><textarea class="field" name="accessibility" maxlength="1000"></textarea></label>
    </div>

    <label class="mt-7 block"><span class="label">{r.note}<span class="font-normal text-taupe">{opt}</span></span><textarea class="field" name="note" maxlength="1500"></textarea></label>

    <!-- honeypot: real people never see or fill this -->
    <div style="position:absolute;left:-9999px;height:0;overflow:hidden" aria-hidden="true"><label>{r.honeypot}<input name="_gotcha" tabindex="-1" autocomplete="off" /></label></div>

    <p data-error role="alert" class="mt-6 min-h-[1.5rem] font-semibold text-error"></p>
    <button class="btn btn-solid mt-2 w-full" type="submit">{r.submit}</button>
  </form>

  <div data-done hidden class="text-center" aria-live="polite"></div>
</div>

<script>
  const root = document.getElementById('rsvp-app')!;
  const T = JSON.parse(root.dataset.i18n!);
  const f$ = (s: string, n: number) => s.replace('{n}', String(n));
  const form = root.querySelector<HTMLFormElement>('[data-form]')!;
  const done = root.querySelector<HTMLElement>('[data-done]')!;
  const errEl = root.querySelector<HTMLElement>('[data-error]')!;
  const only = root.querySelector<HTMLElement>('[data-attending-only]')!;
  const list = root.querySelector<HTMLElement>('[data-guests]')!;
  const addBtn = root.querySelector<HTMLButtonElement>('[data-add-guest]')!;
  const max = Number(root.dataset.max ?? 3);
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const startedAt = Date.now();
  const DRAFT = 'ae-rsvp-draft';

  // Close the form after the deadline (client-side courtesy; the form service itself keeps accepting).
  const dl = root.dataset.deadline;
  if (dl && Date.now() > new Date(`${dl}T23:59:59-07:00`).getTime()) {
    form.hidden = true;
    done.hidden = false;
    done.innerHTML = `<p class="h2">${esc(T.deadlinePassed)}</p><p class="mt-3 text-taupe">${esc(T.deadlineBody)}</p>`;
  }

  const syncAttending = () => {
    const v = form.querySelector<HTMLInputElement>('input[name=attending]:checked')?.value;
    only.hidden = v !== 'Joyfully accepts';
  };
  const renumber = () => [...list.children].forEach((r, i) => {
    r.querySelector('.label')!.textContent = f$(T.guestN, i + 1);
    r.querySelector('button')!.setAttribute('aria-label', f$(T.removeGuest, i + 1));
  });
  const addGuest = (value = '', focus = true) => {
    if (list.children.length >= max) return;
    const row = document.createElement('div');
    row.className = 'flex items-end gap-3';
    row.innerHTML = `<label class="block flex-1"><span class="label"></span><input class="field" name="guest" maxlength="80" autocomplete="off" /></label><button type="button" class="btn !min-h-12 !px-4"><span aria-hidden="true">×</span></button>`;
    row.querySelector('input')!.value = value;
    row.querySelector('button')!.addEventListener('click', () => { row.remove(); addBtn.hidden = false; renumber(); saveDraft(); });
    list.append(row); renumber();
    if (focus) row.querySelector('input')!.focus();
    addBtn.hidden = list.children.length >= max;
  };
  addBtn.addEventListener('click', () => { addGuest(); saveDraft(); });

  // Unsent answers survive a language switch or page change (this browser tab only; cleared once the reply is sent).
  function saveDraft() {
    try {
      const f = new FormData(form);
      const d: Record<string, unknown> = {};
      ['firstName', 'lastName', 'email', 'phone', 'attending', 'dietary', 'accessibility', 'note'].forEach((k) => (d[k] = String(f.get(k) ?? '')));
      d.guests = f.getAll('guest').map(String);
      sessionStorage.setItem(DRAFT, JSON.stringify(d));
    } catch {}
  }
  try {
    const raw = sessionStorage.getItem(DRAFT);
    if (raw) {
      const d = JSON.parse(raw);
      ['firstName', 'lastName', 'email', 'phone', 'dietary', 'accessibility', 'note'].forEach((k) => { const el = form.elements.namedItem(k) as HTMLInputElement | null; if (el && d[k]) el.value = d[k]; });
      if (d.attending) { const r = form.querySelector<HTMLInputElement>(`input[name=attending][value="${d.attending}"]`); if (r) r.checked = true; }
      (d.guests ?? []).forEach((g: string) => addGuest(g, false));
    }
  } catch {}
  syncAttending();
  form.addEventListener('input', saveDraft);
  form.addEventListener('change', () => { syncAttending(); saveDraft(); });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errEl.textContent = '';
    form.querySelectorAll('[aria-invalid]').forEach((n) => n.removeAttribute('aria-invalid'));
    const f = new FormData(form);
    const val = (k: string) => String(f.get(k) ?? '').trim();
    const bad = (name: string, msg: string) => { errEl.textContent = msg; const el = form.querySelector<HTMLElement>(`[name=${name}]`); el?.setAttribute('aria-invalid', 'true'); el?.focus(); };

    if (!val('firstName')) return bad('firstName', T.errFirst);
    if (!val('lastName')) return bad('lastName', T.errLast);
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(val('email'))) return bad('email', T.errEmail);
    if (!val('attending')) return bad('attending', T.errAttending);
    const attending = val('attending') === 'Joyfully accepts';
    const guests = attending ? f.getAll('guest').map((g) => String(g).trim()).filter(Boolean).slice(0, max) : [];
    if (val('_gotcha')) return; // bot: silently drop

    const payload: Record<string, string> = {
      _subject: `RSVP: ${val('firstName')} ${val('lastName')} — ${val('attending')}`,
      firstName: val('firstName'), lastName: val('lastName'), email: val('email'), phone: val('phone'),
      attending: val('attending'),
      additionalGuests: guests.join('; '), partySize: String(1 + guests.length),
      dietary: attending ? val('dietary') : '', accessibility: attending ? val('accessibility') : '', note: val('note'),
      language: T.lang === 'es' ? 'es-MX' : 'en',
      _gotcha: '', secondsOnForm: String(Math.round((Date.now() - startedAt) / 1000)),
    };

    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const label = btn.textContent; btn.disabled = true; btn.textContent = T.sending;
    try {
      const res = await fetch(root.dataset.endpoint!, { method: 'POST', headers: { 'content-type': 'application/json', accept: 'application/json' }, body: JSON.stringify(payload) });
      if (!res.ok) {
        try { console.warn('RSVP service replied', res.status, await res.text()); } catch {}
        errEl.textContent = T.errSend; return;
      }
      try { sessionStorage.removeItem(DRAFT); } catch {}
      showDone(attending, val('email'));
    } catch {
      errEl.textContent = T.errNet;
    } finally { btn.disabled = false; btn.textContent = label; }
  });

  // Confirmation is only ever shown after the service answered with a success status.
  function showDone(attending: boolean, email: string) {
    form.hidden = true; done.hidden = false;
    const g = root.dataset.group;
    done.innerHTML = `
      <h2 tabindex="-1" id="done-h" class="h2">${esc(attending ? T.doneYes : T.doneNo)}</h2>
      <p class="mx-auto mt-5 max-w-md text-taupe">${esc(attending ? T.sentYes : T.sentNo)}</p>
      <p class="mx-auto mt-2 max-w-md text-taupe">${esc(T.emailLine.replace('{email}', email))}</p>
      <div class="mt-9 flex flex-wrap justify-center gap-4">
        ${attending ? `<a class="btn btn-solid" href="${T.next.travel}">${esc(T.planTrip)}</a><a class="btn" href="${T.next.details}">${esc(T.details)}</a>` : `<a class="btn" href="${T.next.home}">${esc(T.back)}</a>`}
      </div>
      ${attending && g ? `<div class="mx-auto mt-12 max-w-md border border-charcoal/20 p-6"><p class="heading text-xl">${esc(T.groupTitle)}</p><p class="mt-3">${esc(T.groupBody)}</p><a class="btn mt-5" href="${esc(g)}" target="_blank" rel="noopener noreferrer">${esc(T.groupBtn)} ↗<span class="sr-only"> ${esc(T.newTab)}</span></a><p class="mt-3 text-taupe">${esc(T.groupNote)}</p></div>` : ''}`;
    done.querySelector<HTMLElement>('#done-h')?.focus();
    window.scrollTo({ top: root.getBoundingClientRect().top + scrollY - 100 });
  }
</script>

---
import { LANGS, htmlLang, dictionaries, swapLangPath, useLang } from '../i18n';
const { lang, t } = useLang(Astro);
const { class: cls = '' } = Astro.props as { class?: string };
---
<div role="group" aria-label={t.nav.language} class={`flex items-center ${cls}`} data-lang-switch-group>
  {LANGS.map((l) => (
    <a href={swapLangPath(Astro.url, l)} lang={htmlLang[l]} hreflang={htmlLang[l]} data-lang-switch={l}
      aria-label={dictionaries[l].localeLabel} aria-current={l === lang ? 'true' : undefined}
      class="lang-link inline-flex min-h-11 min-w-11 items-center justify-center px-1.5 text-[1.0625rem] font-semibold no-underline">{l.toUpperCase()}</a>
  ))}
</div>
<style>
  .lang-link { color: var(--color-taupe); }
  .lang-link:hover { color: var(--color-charcoal); }
  .lang-link[aria-current='true'] { color: var(--color-charcoal); text-decoration: underline; text-decoration-color: var(--color-clay); text-decoration-thickness: 2px; text-underline-offset: .3em; }
  .lang-link + .lang-link { border-left: 1px solid color-mix(in srgb, var(--color-charcoal) 25%, transparent); }
</style>
<script>
  // Switching language: remember the choice, stay on the same page and (when we can tell) the same section.
  const sectionId = (): string => {
    let best = '';
    document.querySelectorAll<HTMLElement>('main [id]').forEach((el) => {
      if (!/^(SECTION|DIV|ARTICLE|DL|FORM)$/.test(el.tagName)) return;
      const r = el.getBoundingClientRect();
      if (r.top <= 140 && r.bottom > 140) best = el.id; // the last (innermost/latest) one containing the reading line
    });
    return best;
  };
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) => {
    a.addEventListener('click', () => {
      const to = a.dataset.langSwitch!;
      try { localStorage.setItem('ae-lang', to); } catch {}
      const hash = location.hash || (sectionId() ? '#' + sectionId() : '');
      const tools = document.querySelector<HTMLDetailsElement>('[data-tools]');
      try {
        sessionStorage.setItem('ae-switch', JSON.stringify({ ts: Date.now(), y: window.scrollY }));
        if (tools?.open) sessionStorage.setItem('ae-switch-tools', '1');
      } catch {}
      a.href = a.getAttribute('href')!.split('#')[0] + hash;
    });
  });
</script>

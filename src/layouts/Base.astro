---
import { u } from '../lib/url';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { couple, wedding, venue } from '../content/site';
import { visibility, plausibleDomain } from '../lib/env';
import { useLang, LANGS, htmlLang, dictionaries, swapLangPath, fmt, dateShort, dateLong } from '../i18n';
import { fullAddress } from '../content/site';

interface Props { title?: string; description?: string; image?: string }
const { lang, t } = useLang(Astro);
const vars = { couple: couple.display, venue: venue.name, city: wedding.cityLine, date: dateLong(wedding.dateISO, lang) };
const { title, description = fmt(t.meta.siteDesc, vars), image = '/img/og.jpg' } = Astro.props;
const fullTitle = title ? fmt(t.meta.titleSep, { page: title, couple: couple.display }) : `${couple.display} · ${dateShort(wedding.dateISO, lang)} · ${wedding.cityLine}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(u(image), Astro.site).href;
const index = visibility() === 'public';
const plausible = plausibleDomain();
const alternates = LANGS.map((l) => ({ l, href: new URL(swapLangPath(Astro.url, l), Astro.site).href }));
const ld = index && {
  '@context': 'https://schema.org', '@type': 'Event', name: `${couple.display}`, startDate: wedding.dateISO, inLanguage: htmlLang[lang],
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: { '@type': 'Place', name: venue.name, address: fullAddress },
};
---
<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f0e6" />
    {!index && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={htmlLang[a.l]} href={a.href} />)}
    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.ogLocale} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={dictionaries[l].ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // A guest who opens a localized link directly gets that language remembered (only if they have not chosen one).
      try { if (!localStorage.getItem('ae-lang')) localStorage.setItem('ae-lang', document.documentElement.lang.slice(0, 2)); } catch (e) {}
    </script>
    {plausible && <script is:inline defer data-domain={plausible} src="https://plausible.io/js/script.js"></script>}
    {ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
  </head>
  <body>
    <a href="#main" class="sr-only z-50 bg-charcoal px-4 py-3 text-ivory focus:not-sr-only focus:fixed focus:left-3 focus:top-3">{t.skip}</a>
    <Nav />
    <main id="main" class="pt-16"><slot /></main>
    <Footer />
    <script>
      // Scroll reveals (opacity only).
      const els = [...document.querySelectorAll<HTMLElement>('.reveal')];
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('in'));

      // After a language switch, land at the same place on the page (a #section in the URL wins; otherwise the same scroll position).
      try {
        const raw = sessionStorage.getItem('ae-switch');
        if (raw) {
          sessionStorage.removeItem('ae-switch');
          const s = JSON.parse(raw);
          if (Date.now() - s.ts < 20000 && !location.hash) window.addEventListener('load', () => window.scrollTo({ top: s.y, behavior: 'instant' as ScrollBehavior }));
        }
      } catch {}
    </script>
  </body>
</html>

---
import { u } from '../lib/url';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { couple, wedding, venue, fullAddress } from '../content/site';
import { visibility, plausibleDomain } from '../lib/env';

interface Props { title?: string; description?: string; image?: string; dark?: boolean }
const { dark = false, title, description = `${couple.display} are getting married on ${wedding.dateLong} at ${venue.name} in ${wedding.cityLine}. Details, travel and RSVP.`, image = '/img/og.jpg' } = Astro.props;
const fullTitle = title ? `${title} · ${couple.display}` : `${couple.display} · ${wedding.dateShort} · ${wedding.cityLine}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(u(image), Astro.site).href;
const index = visibility() === 'public';
const plausible = plausibleDomain();
const ld = index && {
  '@context': 'https://schema.org', '@type': 'Event', name: `${couple.display} Wedding`, startDate: wedding.dateISO,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: { '@type': 'Place', name: venue.name, address: fullAddress },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e181e" />
    {!index && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:alt" content="The couple holding hands on a sunlit beach after their proposal" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    {plausible && <script is:inline defer data-domain={plausible} src="https://plausible.io/js/script.js"></script>}
    {ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
  </head>
  <body data-dark-hero={dark ? '' : undefined}>
    <a href="#main" class="sr-only z-50 bg-charcoal px-4 py-3 text-ivory focus:not-sr-only focus:fixed focus:left-3 focus:top-3">Skip to content</a>
    <Nav />
    <main id="main" class={dark ? '' : 'pt-[4.5rem]'}><slot /></main>
    <Footer />
    <script>
      // Scroll reveals. Clipped "unveil" images are observed through their parent (a fully clipped element never reports as visible).
      const els = [...document.querySelectorAll<HTMLElement>('.reveal, .unveil, .unveil-arch')];
      const show = (t: Element) => {
        t.classList.add('in');
        t.querySelectorAll(':scope > .unveil, :scope > .unveil-arch').forEach((x) => x.classList.add('in'));
      };
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { show(e.target); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach((el) => io.observe(el.matches('.unveil, .unveil-arch') ? el.parentElement ?? el : el));
      } else els.forEach((el) => el.classList.add('in'));
    </script>
  </body>
</html>
